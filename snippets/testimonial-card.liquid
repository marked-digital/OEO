{%- assign t = testimonial -%}
<article class="t-card">
  <div class="t-card__top">
    <div class="t-card__quote-mark" aria-hidden="true">"</div>
    <div class="t-card__stars" aria-label="{{ t.fields.rating.value }} out of 5 stars">
      {%- for i in (1..5) -%}
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1l1.5 4H13l-3.5 2.5 1.5 4L7 9 3 11.5l1.5-4L1 5h4.5z"
            fill="{%- if i <= t.fields.rating.value -%}#d4a800{%- else -%}#e5e7eb{%- endif -%}"/>
        </svg>
      {%- endfor -%}
    </div>
  </div>
  <blockquote class="t-card__quote">
    <p>{{ t.fields.quote.value | escape }}</p>
  </blockquote>
  <footer class="t-card__footer">
    <div class="t-card__avatar">
      {%- if t.fields.photo.value != blank -%}
        <img
          src="{{ t.fields.photo.value | image_url: width: 80 }}"
          alt="{{ t.fields.reviewer_name.value | escape }}"
          width="40" height="40"
          loading="lazy" decoding="async"
        >
      {%- else -%}
        <svg width="18" height="18" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="8" r="4"/>
          <path d="M3 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
        </svg>
      {%- endif -%}
    </div>
    <div class="t-card__meta">
      <span class="t-card__name">{{ t.fields.reviewer_name.value | escape }}</span>
      {%- if t.fields.reviewer_detail.value != blank -%}
        <span class="t-card__detail">{{ t.fields.reviewer_detail.value | escape }}</span>
      {%- endif -%}
      {%- if t.fields.location.value != blank -%}
        <span class="t-card__detail">{{ t.fields.location.value | escape }}</span>
      {%- endif -%}
    </div>
  </footer>
</article>