    "faqs": {
      "type": "pdp-faqs",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "How do I know how many credits I still need?",
            "answer": "<p>Your guidance counsellor maps every remaining credit at your free session, confirms prerequisites, and builds your OSSD pathway plan before your courses open.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Do these credits count toward my OSSD?",
            "answer": "<p>Yes. Every credit you earn with OEO is recorded on your official OSSD transcript, issued by OEO.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "How many courses will I have open at once?",
            "answer": "<p>Two to four courses are open at a time. Finish one and the next opens, so you set the pace across your 12-month term.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "What is the difference between the 6, 7, and 8 credit packs?",
            "answer": "<p>The pack sets how many credits open during your 12-month term. Your counsellor confirms the right count for your pathway at your guidance session.</p>"
          }
        },
        "faq_item_h3DP6J": {
          "type": "faq_item",
          "settings": {
            "question": "What if I change my mind about the courses I selected?",
            "answer": "<p>If you have not started a course, you can switch it. Message your guidance counsellor and they will replace it with another course at your grade level. If you have already begun coursework, speak with your counsellor first, since Ontario reporting rules apply to courses in progress.</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "question": "Do credits from my current school transfer?",
            "answer": "<p>Yes. Your transfer credits are evaluated at your guidance session, before your courses open. Credit transfer and PLAR are available to full-time students only.</p>"
          }
        }
      },
