    "faqs": {
      "type": "pdp-faqs",
      "blocks": {
        "faq_item_FeFy3B": {
          "type": "faq_item",
          "settings": {
            "question": "What is a PLAR?",
            "answer": "<p>PLAR (Prior Learning Assessment and Recognition) is an assessment completed by our guidance team to determine what Ontario Secondary School Diploma (OSSD) credits you may already qualify for based on your previous education, work experience, training, or life experience. It helps us build the fastest pathway to your OSSD.</p>"
          }
        },
        "faq_item_JhwfNq": {
          "type": "faq_item",
          "settings": {
            "question": "Who should purchase a PLAR?",
            "answer": "<p>A PLAR is ideal if you:</p><ul><li>Completed high school outside Ontario or outside Canada.</li><li>Are a mature student returning to school.</li><li>Have work or life experience that may count toward your OSSD.</li><li>Want to know exactly which credits you still need before enrolling.</li></ul>"
          }
        },
        "faq_item_bHQtVj": {
          "type": "faq_item",
          "settings": {
            "question": "How much does the PLAR cost?",
            "answer": "<p>The PLAR assessment is $150 CAD.</p><p>If you decide to enroll in an Ontario Education Online course after your PLAR is complete, we waive the $150 fee, effectively making your PLAR free.</p>"
          }
        },
        "faq_item_NDA74z": {
          "type": "faq_item",
          "settings": {
            "question": "What happens after I purchase?",
            "answer": "<ul><li>Complete the intake form after checkout.</li><li>Upload your transcripts and supporting documentation.</li><li>Our guidance team reviews your information.</li><li>We create a personalized graduation plan outlining credits already recognized, credits still required, and a recommended course sequence.</li><li>We contact you with your results.</li></ul>"
          }
        },
        "faq_item_WYA3Tf": {
          "type": "faq_item",
          "settings": {
            "question": "How long does the assessment take?",
            "answer": "<p>Most PLAR assessments are completed within 1–2 business days after we receive all required documentation.</p>"
          }
        },
        "faq_item_YWUd3E": {
          "type": "faq_item",
          "settings": {
            "question": "What documents do I need?",
            "answer": "<p>Depending on your situation, we may ask for:</p><ul><li>Previous report cards or transcripts</li><li>International educational records</li><li>College or university transcripts</li><li>Training certificates</li><li>Employment history</li><li>Resume</li><li>Other supporting documentation</li></ul><p>Don’t worry if you don’t have everything immediately—we’ll let you know exactly what is needed.</p>"
          }
        }
      },
