            "icon_width": 48,
            "title": "Progress Tracking",
            "content": "<p>Monitor your academic progress effortlessly with the built-in tracking features of Google Classroom. Keep tabs on completed assignments, grades, and overall course advancement to stay on top of your academic goals.</p>"
          }
        },
        "item_AMAD4n": {
          "type": "item",
          "disabled": true,
          "settings": {
