    "multi_column_KhfGpF": {
      "type": "multi-column",
      "blocks": {
        "item_jV3X3q": {
          "type": "item",
          "settings": {
            "column_size": "4",
            "title": "Hand-Picked Ontario Educators",
            "heading_tag": "h5",
            "content": "<p>We hire experienced Ontario-certified teachers and build each course with real marking, real feedback, and real support — not automated grading or generic content.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_pnRMVk": {
          "type": "item",
          "settings": {
            "column_size": "4",
            "title": "Attendance Never Affects Your Grade",
            "heading_tag": "h5",
            "content": "<p>No scheduled classes and no attendance marks. Students learn when they are ready and show what they know through coursework and one final exam, written online from anywhere. No exam halls, no travel, no stress.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_JnRQEX": {
          "type": "item",
          "settings": {
            "column_size": "4",
            "title": "School In Your Pocket",
            "heading_tag": "h5",
            "content": "<p>Complete lessons, submit work, and stay on track right from your phone — perfect for athletes, travel schedules, and busy families. OEO uses Google Classroom as its LMS which is compatible with smart phones.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        },
        "item_hCqxj7": {
          "type": "item",
          "settings": {
            "column_size": "4",
            "title": "Start Anytime + Work At Your Pace",
            "heading_tag": "h5",
            "content": "<p>No semesters. No waitlists. Enroll today and begin immediately, then move fast (or slow) depending on your schedule — it’s built for real life.</p>",
            "link_url": "",
            "link_text": "",
            "link_style": "link"
          }
        }
      },
