        "richtext_hrqDxC": {
          "type": "richtext",
          "settings": {
            "content": "<h5>At Ontario Education Online, we are dedicated to empowering students to take control of their education. We offer a wide range of courses that can be accessed anytime, anywhere, allowing you to learn at your own pace and on your terms. Our curriculum aligns seamlessly with the Ontario educational standards, ensuring that you receive a high-quality education that meets your specific needs.</h5>"
          }
        },
