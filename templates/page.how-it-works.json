          "settings": {
            "text": "How Ontario Education Online Works",
            "heading_tag": "h0",
            "text_color": "",
            "gradient": ""
          }
        },
        "richtext_3MNxKf": {
          "type": "richtext",
          "settings": {
            "content": "<p>At <strong>Ontario Education Online</strong>, students earn <strong>official Ontario Secondary School Diploma (OSSD) credits</strong> online through a structured Google Classroom platform, supported by <strong>Ontario Certified Teachers (OCT)</strong>. Courses follow the Ontario curriculum and allow flexible pacing with ongoing teacher feedback.<br/><br/><br/></p>"
          }
        },
        "liquid_QwrVQP": {
          "type": "liquid",
          "settings": {
            "liquid": "<div class=\"how-list\">\n  <div class=\"how-item\"><span class=\"how-icon\">✓</span><span>Register online</span></div>\n  <div class=\"how-item\"><span class=\"how-icon\">✓</span><span>Get placed into your Google Classroom</span></div>\n  <div class=\"how-item\"><span class=\"how-icon\">✓</span><span>Learn at your own pace with teacher feedback</span></div>\n  <div class=\"how-item\"><span class=\"how-icon\">✓</span><span>Finish the course</span></div>\n  <div class=\"how-item\"><span class=\"how-icon\">✓</span><span>Report card + transcript sent to your home school</span></div>\n</div>\n\n<style>\n  .how-list{\n    max-width: 520px;\n    margin: 28px auto 0;\n    display: grid;\n    gap: 14px;\n    text-align: left;\n  }\n\n  .how-item{\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    padding: 12px 14px;\n    border-radius: 12px;\n    background: rgba(255,255,255,0.08);\n    border: 1px solid rgba(255,255,255,0.12);\n    color: #fff;\n    font-size: 18px;\n    line-height: 1.45;\n  }\n\n  .how-icon{\n    color: #A6CE39;\n    font-weight: 700;\n    margin-top: 2px;\n    flex: 0 0 auto;\n  }\n</style>"
          }
        }
      },
