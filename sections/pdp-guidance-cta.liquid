<style>
  .pdp-guidance {
    padding: 64px 0 80px;
    background: #ffffff;
  }

  .pdp-guidance__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Advisor photo */
  .pdp-guidance__avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    border: 1.5px solid #d1d5db;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f9fafb;
    flex-shrink: 0;
  }

  .pdp-guidance__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
  }

  .pdp-guidance__avatar-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    color: #9ca3af;
  }

  .pdp-guidance__avatar-placeholder span {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  /* Heading */
  .pdp-guidance__title {
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    font-weight: 700;
    color: #1e2a5e;
    line-height: 1.2;
    margin: 0 0 16px;
    max-width: 640px;
  }

  /* Body copy */
  .pdp-guidance__body {
    font-size: 0.97rem;
    color: #6b7280;
    line-height: 1.7;
    margin: 0 0 32px;
    max-width: 560px;
  }

  /* CTA button */
  .pdp-guidance__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    background: #F0C417;
    color: #1e2a5e;
    border-radius: 999px;
    font-size: 0.97rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
    margin-bottom: 16px;
  }

  .pdp-guidance__btn:hover {
    background: #c49b00;
    transform: translateY(-1px);
  }

  .pdp-guidance__btn:active {
    transform: translateY(0);
  }

  .pdp-guidance__btn svg {
    flex-shrink: 0;
  }

  /* Social proof line */
  .pdp-guidance__proof {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: #6b7280;
  }

  .pdp-guidance__proof-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }

  @media (max-width: 580px) {
    .pdp-guidance {
      padding: 40px 0 56px;
    }
    .pdp-guidance__inner {
      padding: 0 16px;
    }
    .pdp-guidance__title {
      font-size: clamp(1.4rem, 5vw, 1.8rem);
    }
  }
</style>

<section
  class="pdp-guidance"
  aria-labelledby="pdp-guidance-heading-{{ section.id }}"
>
  <div class="pdp-guidance__inner">

    <div class="pdp-guidance__avatar">
      {%- if section.settings.advisor_image != blank -%}
        <img
          src="{{ section.settings.advisor_image | image_url: width: 200 }}"
          alt="{{ section.settings.advisor_image.alt | default: 'Advisor photo' | escape }}"
          width="96"
          height="96"
          loading="lazy"
          decoding="async"
        >
      {%- else -%}
        <div class="pdp-guidance__avatar-placeholder" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <circle cx="11" cy="8" r="4"/>
            <path d="M3 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
          </svg>
          <span>Advisor<br>Photo</span>
        </div>
      {%- endif -%}
    </div>

    <h2 class="pdp-guidance__title" id="pdp-guidance-heading-{{ section.id }}">
      {{ section.settings.heading | escape }}
    </h2>

    <p class="pdp-guidance__body">
      {{ section.settings.body_text | escape }}
    </p>

    <a
      href="{{ section.settings.button_url }}"
      class="pdp-guidance__btn"
      aria-label="{{ section.settings.button_aria_label | escape }}"
    >
      <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="1.5" y="3" width="15" height="13.5" rx="1.5"/>
        <path d="M1.5 7.5h15M6 1.5v3M12 1.5v3"/>
        <rect x="4.5" y="10" width="2" height="2" rx="0.4" fill="currentColor" stroke="none"/>
        <rect x="8" y="10" width="2" height="2" rx="0.4" fill="currentColor" stroke="none"/>
        <rect x="11.5" y="10" width="2" height="2" rx="0.4" fill="currentColor" stroke="none"/>
      </svg>
      {{ section.settings.button_label | escape }}
    </a>

    {%- if section.settings.proof_text != blank -%}
      <div class="pdp-guidance__proof" aria-label="{{ section.settings.proof_text | escape }}">
        <span class="pdp-guidance__proof-dot" aria-hidden="true"></span>
        {{ section.settings.proof_text | escape }}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "PDP - Guidance CTA",
  "tag": "section",
  "limit": 1,
  "settings": [
    {
      "type": "image_picker",
      "id": "advisor_image",
      "label": "Advisor photo",
      "info": "Circular crop, recommended 200×200px minimum"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure if this course is right for your situation?"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body text",
      "default": "Book a free 15-minute guidance session with one of our advisors. We'll review your transcript, answer your questions about prerequisites, and make sure you're set up for success. No obligation, no pressure."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book Free Guidance Session"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "button_aria_label",
      "label": "Button accessible label",
      "default": "Book a free 15-minute guidance session with an OEO advisor"
    },
    {
      "type": "text",
      "id": "proof_text",
      "label": "Social proof text",
      "default": "247 families booked a session this year",
      "info": "Leave blank to hide"
    }
  ],
  "presets": [
    {
      "name": "PDP - Guidance CTA"
    }
  ]
}
{% endschema %}