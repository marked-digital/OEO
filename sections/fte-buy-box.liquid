  min-height: 54px;
  padding: 0 24px;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: -0.01em;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.08);
  cursor: pointer;
}

.pdp-mob-bar__btn:hover {
  background: #d9b82f;
}

/* Two-action bar: guidance and enrol side by side */
.pdp-mob-bar__actions {
  flex: 0 0 auto;
  display: flex;
  align-items: stretch;
  gap: 10px;
  min-width: 0;
}

.pdp-mob-bar--fte .pdp-mob-bar__btn {
  min-height: 50px;
  padding: 0 20px;
  font-size: 14px;
  text-decoration: none;
  text-align: center;
  line-height: 1.2;
}

/* The primary of the pair is solid gold; the other is an outline on the navy bar */
.pdp-mob-bar__btn--ghost,
.pdp-mob-bar--guidance-first .pdp-mob-bar__btn--enrol,
.pdp-mob-bar--enrol-first .pdp-mob-bar__btn--guidance {
  background: transparent;
  border: 1.5px solid rgba(255, 255, 255, 0.55);
  color: #ffffff;
  box-shadow: none;
}

.pdp-mob-bar--guidance-first .pdp-mob-bar__btn--enrol:hover,
.pdp-mob-bar--enrol-first .pdp-mob-bar__btn--guidance:hover {
  background: rgba(255, 255, 255, 0.12);
  border-color: #ffffff;
}

.pdp-mob-bar--guidance-first .pdp-mob-bar__btn--guidance,
.pdp-mob-bar--enrol-first .pdp-mob-bar__btn--enrol {
  background: #e2c23b;
  border: none;
  color: #24367a;
}

.pdp-mob-bar--guidance-first .pdp-mob-bar__btn--guidance:hover,
.pdp-mob-bar--enrol-first .pdp-mob-bar__btn--enrol:hover {
  background: #d9b82f;
}

/* Responsive */
@media (max-width: 959px) {
  .pdp-hero {
    padding: 28px 0 28px;
  }

  .pdp-hero__inner {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 16px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: flex-start;
  }

  .pdp-hero__content,
  .pdp-hero__enrol-wrap {
    min-width: 0;
  }

  /* Course-details pill: scale down and allow it to wrap inside the viewport */
  .pdp-hero__pill {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    width: fit-content;
    max-width: 100%;
    padding: 8px 14px;
    gap: 2px 0;
    font-size: 11px;
    letter-spacing: 0.08em;
    line-height: 1.3;
    margin-bottom: 14px;
  }

  .pdp-hero__pill-sep {
    margin: 0 8px;
  }

  .pdp-hero__title {
    font-size: clamp(2rem, 8vw, 2.7rem);
    line-height: 1.02;
    margin-bottom: 12px;
    word-break: break-word;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

   .pdp-hero__callouts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin: 0 0 10px;
    font-size: 14px;
    line-height: 1.45;
    max-width: 100%;
  }

  .pdp-hero__callouts span {
    white-space: normal;
  }

  .pdp-hero__callouts-sep {
    margin: 0;
    flex: 0 0 auto;
  }

  .pdp-hero__description {
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 22px;
    max-width: 100%;
  }

  /* Bottom row: keep side-by-side on mobile but tighten */
  .pdp-hero__bottom-row {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 14px;
    align-items: flex-start;
  }

  .pdp-hero__product-card {
    width: 200px;
    padding: 0px;
    border-radius: 14px;
  }

  .pdp-hero__product-card-frame {
    border-radius: 6px;
  }

  .pdp-hero__teacher {
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px;
    padding: 12px 14px;
  }

  .pdp-hero__teacher-media {
    width: 44px;
    height: 44px;
  }

  .pdp-hero__teacher-tag {
    grid-column: 1 / -1;
    justify-self: start;
    margin-top: 2px;
  }

  .pdp-hero__enrol-card {
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
    padding: 18px 16px 18px;
    border-radius: 22px;
    overflow: hidden;
  }

  .pdp-hero__price-row {
    gap: 4px 6px;
  }

  .pdp-hero__price-main {
    font-size: 28px;
  }

  .pdp-hero__price-curr {
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .pdp-hero__price-sub,
  .pdp-hero__payment-plan,
  .pdp-hero__urgency,
  .pdp-hero__guidance-btn,
  .pdp-hero__enrol-disclaimer {
    font-size: 13px;
    line-height: 1.55;
  }

  .pdp-hero__payment-plan,
  .pdp-hero__urgency {
    flex-wrap: wrap;
  }

  .pdp-hero__enrol-btn {
    width: 100%;
    min-height: 56px;
    padding: 14px 18px;
    font-size: 14px;
    line-height: 1.2;
    text-align: center;
    white-space: normal;
  }

  .pdp-hero__enrol-disclaimer {
    margin: 10px 0 16px;
  }

  .pdp-hero__trust-trio {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 14px 0 0;
  }

  .pdp-hero__trust-chip {
    min-width: 0;
    min-height: 92px;
    padding: 12px 10px;
  }

  .pdp-hero__trust-chip:last-child {
    grid-column: 1 / -1;
  }

  .pdp-hero__trust-chip-label {
    font-size: 10px;
    line-height: 1.25;
  }

  .pdp-hero__guidance-btn {
    margin: 0 0 12px;
  }

  .pdp-hero__variant {
    margin-top: 4px;
  }

  .pdp-hero__variant-label {
    margin-bottom: 6px;
  }

  .pdp-hero__variant-select {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 12px 14px;
    font-size: 14px;
  }

  .pdp-mob-bar {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Two rows on mobile: the course line reads in full, the two CTAs share the
     row beneath it. Nothing here clips, so price and course code stay visible
     however long the variant name is. */
  .pdp-mob-bar--fte .pdp-mob-bar__inner {
    flex-direction: column;
    align-items: stretch;
    gap: 9px;
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
  }

  /* Stacked rather than wrapped, so the price line and the course line keep the
     same order and hierarchy on every screen width */
  .pdp-mob-bar--fte .pdp-mob-bar__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pdp-mob-bar--fte .pdp-mob-bar__price,
  .pdp-mob-bar--fte .pdp-mob-bar__sub {
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .pdp-mob-bar--fte .pdp-mob-bar__price {
    font-size: clamp(13px, 3.7vw, 15px);
    line-height: 1.25;
  }

  .pdp-mob-bar--fte .pdp-mob-bar__sub {
    margin-top: 0;
    font-size: clamp(11px, 3vw, 12.5px);
    line-height: 1.3;
  }

  .pdp-mob-bar--fte .pdp-mob-bar__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .pdp-mob-bar--fte.pdp-mob-bar--single .pdp-mob-bar__actions {
    grid-template-columns: 1fr;
  }

  .pdp-mob-bar--fte .pdp-mob-bar__btn {
    width: 100%;
    min-height: 46px;
    padding: 8px 10px;
    font-size: clamp(12px, 3.2vw, 14px);
    white-space: normal;
  }

  /* Fallback clearance; the script replaces it with the bar's measured height */
  body {
    padding-bottom: 132px;
  }
}

@media (max-width: 480px) {
  .pdp-hero__product-card {
    width: 96px;
  }

  /* Smallest phones: tighten further, and let a long single token break */
  .pdp-hero__pill {
    padding: 7px 12px;
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  /* A single overlong token breaks inside its group rather than overflowing.
     flex-wrap: nowrap on the group still keeps the "|" fused to its item. */
  .pdp-hero__pill-group {
    max-width: 100%;
    min-width: 0;
  }

  .pdp-hero__pill-item {
    white-space: normal;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .pdp-hero__pill-sep {
    margin: 0 6px;
    flex: 0 0 auto;
  }
}

@media (min-width: 960px) {
  .pdp-mob-bar {
    left: 50%;
    right: auto;
    bottom: 24px;
    width: min(760px, calc(100vw - 48px));
    transform: translateX(-50%) translateY(110%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .pdp-mob-bar.is-visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .pdp-mob-bar__inner {
    width: 100%;
    border-radius: 18px;
    padding: 14px 16px;
  }
}

</style>

<template id="quick-buy-content">
  {%- capture product_form_id -%}quick-buy-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}

  <div class="quick-buy-drawer__variant text-start h-stack gap-6" slot="header">
    {%- assign image = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}

    {%- if image != blank -%}
      <variant-media widths="80,160" form="{{ product_form_id }}">
        {{- image | image_url: width: image.width | image_tag: loading: 'lazy', sizes: '80px', widths: '80,160', class: 'quick-buy-drawer__media rounded-xs' -}}
      </variant-media>
    {%- endif -%}

    <div class="v-stack gap-0.5">
      <a href="{{ product.url }}" class="bold justify-self-start">{{ product.title }}</a>
      {%- render 'price-list', product: product, variant: product.selected_or_first_available_variant, form_id: product_form_id -%}
    </div>
  </div>

  <div class="quick-buy-drawer__info">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {%- render block -%}

        {%- when 'variant_picker' -%}
          {%- render 'variant-picker', product: product, form_id: product_form_id, update_url: false, hide_sold_out_variants: block.settings.hide_sold_out_variants, hide_size_chart: true, force_dropdown_as_block: true, block: block -%}

        {%- when 'buy_buttons' -%}
          {%- render 'buy-buttons', product: product, form_id: product_form_id, show_payment_button: block.settings.show_payment_button, button_size: 'lg' -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</template>

