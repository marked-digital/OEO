<section class="pdp-hero" aria-labelledby="course-title">
  <div class="pdp-hero__inner">

    {%- comment %}
      Resolve product / teacher context
    {%- endcomment -%}
    {%- assign current_product = product -%}
    {%- assign current_variant = current_product.selected_or_first_available_variant -%}

    {%- assign teacher = nil -%}
    {%- if current_product and current_product.metafields.custom.teacher and current_product.metafields.custom.teacher.value -%}
      {%- assign teacher = current_product.metafields.custom.teacher.value -%}
    {%- endif -%}

    {%- assign grade_level = current_product.metafields.custom.grade_level | default: '' -%}
    {%- assign course_subject = current_product.metafields.custom.subject | default: '' -%}
    {%- assign course_code = current_product.metafields.custom.course_code | default: '' -%}
    {%- assign course_prereq = current_product.metafields.custom.prerequisite -%}

    <!-- Left column: content -->
    <div class="pdp-hero__content">

      {%- if grade_level != '' or course_subject != '' or course_code != '' -%}
      {%- comment %}
        Each separator is grouped with the item that follows it, so when the
        pill wraps on a narrow viewport a "|" can never be orphaned at the
        start of a line. Groups are inline-flex, so the row reads identically.
      {%- endcomment -%}
      <div class="pdp-hero__pill" aria-label="Course details">
        {%- if grade_level != '' -%}
          <span class="pdp-hero__pill-group">
            <span class="pdp-hero__pill-item">Grade {{ grade_level }}</span>
          </span>
        {%- endif -%}
        {%- if course_subject != '' -%}
          <span class="pdp-hero__pill-group">
            {%- if grade_level != '' -%}
              <span class="pdp-hero__pill-sep" aria-hidden="true">|</span>
            {%- endif -%}
            <span class="pdp-hero__pill-item">{{ course_subject }}</span>
          </span>
        {%- endif -%}
        {%- if course_code != '' -%}
          <span class="pdp-hero__pill-group">
            {%- if grade_level != '' or course_subject != '' -%}
              <span class="pdp-hero__pill-sep" aria-hidden="true">|</span>
            {%- endif -%}
            <span class="pdp-hero__pill-item">{{ course_code }}</span>
          </span>
        {%- endif -%}
      </div>
      {%- endif -%}

      <h1 class="pdp-hero__title" id="course-title">
        {{ current_product.title }}
      </h1>

      {%- comment %} Prerequisite (eligibility) — mirrors the row in PDP Course Details {%- endcomment -%}
      {%- if course_prereq != blank -%}
        <p class="pdp-hero__prereq">
          <span class="pdp-hero__prereq-icon" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
              <path d="M10.5 2.5H12a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M5.5 2.5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v.5h-5v-.5z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M5.5 8l1.5 1.5L10 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="pdp-hero__prereq-label">Prerequisite:</span>
          <span class="pdp-hero__prereq-value">{{ course_prereq.value }}</span>
          {%- if section.settings.prereq_help_text != blank and section.settings.prereq_help_url != blank -%}
            <a href="{{ section.settings.prereq_help_url }}" class="pdp-hero__prereq-link">
              {{ section.settings.prereq_help_text }}
            </a>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- comment %} Three small editable callouts under title {%- endcomment -%}
      {%- if section.settings.callout_1 != blank or section.settings.callout_2 != blank or section.settings.callout_3 != blank -%}
        <p class="pdp-hero__callouts">
          {%- assign printed = 0 -%}
          {%- if section.settings.callout_1 != blank -%}
            <span>{{ section.settings.callout_1 }}</span>
            {%- assign printed = printed | plus: 1 -%}
          {%- endif -%}
          {%- if section.settings.callout_2 != blank -%}
            {%- if printed > 0 -%}<span class="pdp-hero__callouts-sep" aria-hidden="true">•</span>{%- endif -%}
            <span>{{ section.settings.callout_2 }}</span>
            {%- assign printed = printed | plus: 1 -%}
          {%- endif -%}
          {%- if section.settings.callout_3 != blank -%}
            {%- if printed > 0 -%}<span class="pdp-hero__callouts-sep" aria-hidden="true">•</span>{%- endif -%}
            <span>{{ section.settings.callout_3 }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- comment %} Rating {%- endcomment -%}
      {%- if section.settings.rating_value != blank or section.settings.rating_count != blank -%}
        <div class="pdp-hero__rating" aria-label="{{ section.settings.rating_value }} out of 5 stars{% if section.settings.rating_count != blank %}, {{ section.settings.rating_count }} students{% endif %}">
          <span class="pdp-hero__rating-stars" aria-hidden="true">★★★★★</span>
          {%- if section.settings.rating_value != blank -%}
            <span class="pdp-hero__rating-value">{{ section.settings.rating_value }}</span>
          {%- endif -%}
          {%- if section.settings.rating_count != blank -%}
            <span class="pdp-hero__rating-count">· {{ product.metafields.custom.enrolment_seed.value | default: 0 | plus: shop.metafields.custom.enrolment_orders.value }} {{ section.settings.rating_count }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment %} Product description {%- endcomment -%}
      {%- if current_product.description != blank -%}
        <div class="pdp-hero__description rte">
          {{ current_product.description }}
        </div>
      {%- endif -%}

      {%- comment %} Bottom row: teacher card on the left, product image card on the right {%- endcomment -%}
      <div class="pdp-hero__bottom-row">

        <div class="pdp-hero__bottom-main">

          {%- comment %} Teacher badge {%- endcomment -%}
          {%- if teacher -%}
            <div class="pdp-hero__teacher" role="group" aria-label="Your teacher for this course">
              <div class="pdp-hero__teacher-media">
                {%- if teacher.teacher_image and teacher.teacher_image.value != blank -%}
                  {{
                    teacher.teacher_image
                    | image_url: width: 120
                    | image_tag:
                      class: 'pdp-hero__teacher-img',
                      loading: 'lazy',
                      widths: '80, 120, 160',
                      alt: teacher.teacher_name.value | default: 'Course teacher'
                  }}
                {%- else -%}
                  <div class="pdp-hero__teacher-ph" aria-hidden="true">
                    <span class="pdp-hero__teacher-ph-label">Teacher<br>Photo</span>
                  </div>
                {%- endif -%}
              </div>
              <div class="pdp-hero__teacher-main">
                {%- if teacher.teacher_name and teacher.teacher_name.value != blank -%}
                  <div class="pdp-hero__teacher-name">{{ teacher.teacher_name.value }}</div>
                {%- endif -%}
                {%- if teacher.teacher_position and teacher.teacher_position.value != blank -%}
                  <div class="pdp-hero__teacher-role">{{ teacher.teacher_position.value }}</div>
                {%- endif -%}
              </div>
              <span class="pdp-hero__teacher-tag">OCT Certified</span>
            </div>
          {%- endif -%}

          {%- if section.settings.watch_label != blank -%}
            <a href="{{ section.settings.watch_link | default: '#how-it-works' }}" class="pdp-hero__watch" {% if section.settings.watch_link_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
              <span class="pdp-hero__watch-icon" aria-hidden="true">
                <svg viewBox="0 0 10 12"><path d="M1 1.5l8 4.5-8 4.5V1.5z"></path></svg>
              </span>
              {{ section.settings.watch_label }}
            </a>
          {%- endif -%}

        </div>

        {%- comment %} Product image card (next to teacher credentials) {%- endcomment -%}
        {%- if current_product.featured_image != blank -%}
          <div class="pdp-hero__product-card" aria-hidden="true">
            <div class="pdp-hero__product-card-frame">
              {{
                current_product.featured_image
                | image_url: width: 600
                | image_tag:
                  class: 'pdp-hero__product-card-img',
                  loading: 'lazy',
                  widths: '240, 360, 480, 600',
                  sizes: '(max-width: 959px) 40vw, 220px',
                  alt: current_product.featured_image.alt | default: current_product.title
              }}
            </div>
          </div>
        {%- endif -%}

      </div>

    </div>

    <!-- Right column: enrolment card / add-to-cart -->
    <div class="pdp-hero__enrol-wrap">
      <div class="pdp-hero__enrol-card" role="region" aria-label="Enrolment and pricing">

        {%- form 'product', current_product, id: 'pdp-hero-product-form', class: 'pdp-hero__form' -%}

          <!-- Price row -->
          <div class="pdp-hero__price-row">
            <span class="pdp-hero__price-main" data-product-price>
              {{ current_variant.price | money }}
            </span>
            <span class="pdp-hero__price-curr">{{ cart.currency.iso_code }}</span>

            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="pdp-hero__price-compare" data-product-compare>
                {{ current_variant.compare_at_price | money }}
              </span>
              <span class="pdp-hero__price-pill" data-product-sale-pill>{{ section.settings.sale_badge_label | default: 'Bundle savings' }}</span>
            {%- else -%}
              <span class="pdp-hero__price-compare" data-product-compare style="display:none;"></span>
              <span class="pdp-hero__price-pill" data-product-sale-pill style="display:none;">{{ section.settings.sale_badge_label | default: 'Bundle savings' }}</span>
            {%- endif -%}
          </div>

          <!-- Price copy -->
          {%- if section.settings.price_subcopy != blank -%}
            <p class="pdp-hero__price-sub">
              {{ section.settings.price_subcopy }}
            </p>
          {%- endif -%}

          <!-- Thin divider (like prototype) -->
          <div class="pdp-hero__card-divider pdp-hero__card-divider--light" role="separator"></div>

          <!-- Option selectors (one control per product option) -->
          {%- if current_product.has_only_default_variant == false -%}
            {%- comment %}
              Multi-option courses (e.g. Co-op) always use toggles.
              Single-option courses follow the theme setting below.
            {%- endcomment -%}
            {%- assign use_dropdown = false -%}
            {%- if current_product.options_with_values.size == 1 and section.settings.single_option_picker_style == 'dropdown' -%}
              {%- assign use_dropdown = true -%}
            {%- endif -%}

            <div class="pdp-hero__options" data-pdp-options>
              {%- for option in current_product.options_with_values -%}
                <div class="pdp-hero__option">
                  <span class="pdp-hero__variant-label">{{ option.name }}</span>
                  {%- if use_dropdown -%}
                    <select
                      class="pdp-hero__variant-select"
                      data-option-select
                      aria-label="{{ option.name | escape }}"
                    >
                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                      {%- endfor -%}
                    </select>
                  {%- else -%}
                    <div class="pdp-hero__option-pills" role="radiogroup" aria-label="{{ option.name | escape }}">
                      {%- for value in option.values -%}
                        <button
                          type="button"
                          class="pdp-hero__pill-btn{% if option.selected_value == value %} is-selected{% endif %}"
                          role="radio"
                          aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                          data-option-value="{{ value | escape }}"
                        >{{ value }}</button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>

            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

            <script type="application/json" data-pdp-variant-map>
              {
                {%- for variant in current_product.variants -%}
                  "{{ variant.options | join: '~~' }}": {
                    "id": {{ variant.id }},
                    "available": {{ variant.available }},
                    "priceFmt": {{ variant.price | money | json }},
                    "compareFmt": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              }
            </script>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>
          {%- endif -%}

          <!-- Payment plan -->
          {%- if section.settings.payment_plan_text != blank -%}
            <div class="pdp-hero__payment-plan">
              <svg width="14" height="12" viewBox="0 0 14 12" fill="none" aria-hidden="true">
                <rect x="1" y="1.5" width="12" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"></rect>
                <path d="M1 5h12" stroke="currentColor" stroke-width="1.3"></path>
              </svg>
              {{ section.settings.payment_plan_text }}
            </div>
          {%- endif -%}

          <!-- Urgency -->
          {%- if section.settings.urgency_text != blank -%}
            <div class="pdp-hero__urgency" role="status" aria-live="polite">
              {{ section.settings.urgency_text }}
            </div>
          {%- endif -%}

          <!-- Guidance secondary button (sits above the primary CTA so the low-commitment ask is read first) -->
          {%- if section.settings.guidance_text != blank and section.settings.guidance_url != blank -%}
            <a
              href="{{ section.settings.guidance_url }}"
              class="pdp-hero__guidance-btn"
              {% if section.settings.guidance_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ section.settings.guidance_text }}
            </a>
          {%- endif -%}

          <!-- Primary CTA -->
          {%- if current_variant.available -%}
            <button
              type="submit"
              name="add"
              class="pdp-hero__enrol-btn"
              data-enrol-btn
            >
              <span data-enrol-btn-label>
                {{ section.settings.enrol_label | default: 'Enrol Now' }}
              </span>
              <span class="pdp-hero__enrol-btn-price" data-enrol-btn-price>
                · {{ current_variant.price | money }} {{ cart.currency.iso_code }}
              </span>
            </button>
          {%- else -%}
            <button
              type="button"
              class="pdp-hero__enrol-btn pdp-hero__enrol-btn--disabled"
              disabled
              data-enrol-btn
            >
              <span data-enrol-btn-label>Sold Out</span>
              <span class="pdp-hero__enrol-btn-price" data-enrol-btn-price style="display:none;"></span>
            </button>
          {%- endif -%}

          <!-- Enrol note: credits check, set here so it goes live on push (the 12-month term line lives in the program bullets) -->
          <div class="pdp-hero__enrol-disclaimer">
            <p>
              Make sure you've selected the right number of credits before you enrol.
              {% if section.settings.guidance_url != blank -%}
                <a href="{{ section.settings.guidance_url }}"{% if section.settings.guidance_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>Book a free guidance session</a>
              {%- else -%}
                Book a free guidance session
              {%- endif %} if you're unsure. We'd be happy to speak with you.
            </p>
          </div>

          <!-- Divider before program bullets -->
          <div class="pdp-hero__card-divider" role="separator"></div>

          <!-- Program bullets (FTE) -->
          {%- assign bullet_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'bullet' -%}{%- assign bullet_count = bullet_count | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if bullet_count > 0 -%}
            <ul class="pdp-hero__bullets">
              {%- for block in section.blocks -%}
                {%- if block.type == 'bullet' and block.settings.text != blank -%}
                  {%- assign bullet_icon = block.settings.icon | default: 'check' -%}
                  <li class="pdp-hero__bullet" {{ block.shopify_attributes }}>
                    <span class="pdp-hero__bullet-check pdp-hero__bullet-check--{{ bullet_icon }}" aria-hidden="true">
                      {%- case bullet_icon -%}
                        {%- when 'plus' or 'plus-grey' -%}
                          <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 2.4v7.2M2.4 6h7.2"/></svg>
                        {%- when 'star' -%}
                          <svg viewBox="0 0 12 12" width="10" height="10" fill="currentColor"><path d="M6 1.3l1.45 2.94 3.25.47-2.35 2.29.55 3.23L6 8.71 3.1 10.23l.55-3.23L1.3 4.71l3.25-.47L6 1.3z"/></svg>
                        {%- else -%}
                          <svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.2l2.2 2.2L9.5 3.6"/></svg>
                      {%- endcase -%}
                    </span>
                    <span>{{ block.settings.text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <!-- Trust badges -->
          <div class="pdp-hero__trust-trio" role="list" aria-label="School credentials">
            <div class="pdp-hero__trust-chip" role="listitem">
              <span class="pdp-hero__trust-chip-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <path d="M1.5 19h17M3.5 19V9M16.5 19V9M1.5 9.5L10 2l8.5 7.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M7.5 19v-5h5v5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="pdp-hero__trust-chip-label">Ministry Inspected</span>
            </div>

            <div class="pdp-hero__trust-chip" role="listitem">
              <span class="pdp-hero__trust-chip-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.4"></circle>
                  <path d="M3 18.5c0-3.9 3.1-7 7-7s7 3.1 7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                  <path d="M13 3.5l2.5 1.5-2.5 2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
              <span class="pdp-hero__trust-chip-label">OCT-Certified Teacher</span>
            </div>

            <div class="pdp-hero__trust-chip" role="listitem">
              <span class="pdp-hero__trust-chip-icon" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none">
                  <path d="M10 12.5L1.5 8 10 3.5l8.5 4.5-8.5 4.5z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M5 10.5V15c0 1.7 2.2 3 5 3s5-1.3 5-3v-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
                  <path d="M18.5 8v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
                </svg>
              </span>
              <span class="pdp-hero__trust-chip-label">Official OSSD Credit</span>
            </div>
          </div>

        {%- endform -%}

      </div>
    </div>

  </div>
</section>

{%- comment %}
  Sticky quick enrol bar (mobile: always visible, desktop: appears on scroll)

  Full-time carries a bigger commitment than a single course, so this bar leads
  with the guidance ask and keeps enrolment beside it. Which of the two reads as
  primary is a setting; guidance is the default. The regular product page keeps
  its own single-CTA bar in pdp-product.liquid, untouched by anything here — the
  --fte modifier scopes every rule below to this section.
{%- endcomment -%}
{%- assign mob_guidance_url = section.settings.mob_bar_guidance_url | default: section.settings.guidance_url -%}
{%- assign mob_guidance_label = section.settings.mob_bar_guidance_label | default: 'Talk to Guidance' -%}
{%- assign mob_primary = section.settings.mob_bar_primary | default: 'guidance' -%}

<div
  class="pdp-mob-bar pdp-mob-bar--fte pdp-mob-bar--{{ mob_primary }}-first{% if mob_guidance_url == blank %} pdp-mob-bar--single{% endif %}"
  aria-label="Quick enrolment"
  role="complementary"
  data-quick-enrol
>
  <div class="pdp-mob-bar__inner">
    <div class="pdp-mob-bar__info">
      <div class="pdp-mob-bar__price" data-quick-enrol-price>
  {{ section.settings.mob_bar_label | default: 'Get Started' }} · {{ current_variant.price | money }} {{ cart.currency.iso_code }}
</div>
      <div class="pdp-mob-bar__sub">
        {{ course_code | default: current_product.title }} · {{ section.settings.quick_enrol_subtext | default: 'Instant Access' }}
      </div>
    </div>

    <div class="pdp-mob-bar__actions">
      {%- if mob_guidance_url != blank -%}
        <a
          class="pdp-mob-bar__btn pdp-mob-bar__btn--guidance"
          href="{{ mob_guidance_url }}"
          {% if section.settings.guidance_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
          aria-label="{{ mob_guidance_label | escape }} about {{ current_product.title | escape }}"
        >
          {{ mob_guidance_label }}
        </a>
      {%- endif -%}

      <button
        type="button"
        class="pdp-mob-bar__btn pdp-mob-bar__btn--enrol"
        data-quick-enrol-btn
        aria-label="Enrol now in {{ current_product.title | escape }}"
      >
        {{ section.settings.enrol_label | default: 'Enrol Now' }} →
      </button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var form = document.getElementById('pdp-hero-product-form');
  if (!form) return;

  var idInput    = form.querySelector('[data-variant-id-input]');
  var optionWrap = form.querySelector('[data-pdp-options]');
  var priceEl    = form.querySelector('[data-product-price]');
  var compareEl  = form.querySelector('[data-product-compare]');
  var salePillEl = form.querySelector('[data-product-sale-pill]');
  var btn        = form.querySelector('[data-enrol-btn]');
  var btnLabel   = form.querySelector('[data-enrol-btn-label]');
  var btnPriceEl = form.querySelector('[data-enrol-btn-price]');
  var currency   = '{{ cart.currency.iso_code }}';
  var enrolLabel = '{{ section.settings.enrol_label | default: "Enrol Now" }}';

  // Variant lookup map, keyed by option values joined with ~~
  var variantMap = {};
  var mapEl = form.querySelector('[data-pdp-variant-map]');
  if (mapEl) { try { variantMap = JSON.parse(mapEl.textContent); } catch (e) {} }

  // Sticky bar elements
  var quickBar   = document.querySelector('[data-quick-enrol]');
  var quickBtn   = quickBar ? quickBar.querySelector('[data-quick-enrol-btn]') : null;
  var quickPrice = quickBar ? quickBar.querySelector('[data-quick-enrol-price]') : null;
  var heroSection = document.querySelector('.pdp-hero');

  function syncQuickBarPrice() {
    if (!quickBar || !quickPrice || !priceEl) return;
    var label = '{{ section.settings.mob_bar_label | default: "Get Started" }}';
    quickPrice.textContent = label + ' · ' + priceEl.textContent.trim() + ' ' + currency;
    // A longer price can add a line to the bar, so re-measure the clearance
    syncQuickBarSpace();
  }

  // The mobile bar wraps to two rows and its height varies with the course line,
  // so reserve exactly what it occupies rather than a fixed guess.
  function syncQuickBarSpace() {
    if (!quickBar) return;
    if (window.innerWidth < 960) {
      document.body.style.paddingBottom = (quickBar.offsetHeight + 8) + 'px';
    } else {
      document.body.style.paddingBottom = '';
    }
  }

  function updateDesktopQuickBar() {
    if (!quickBar || !heroSection) return;
    if (window.innerWidth < 960) {
      quickBar.classList.add('is-visible');
      return;
    }
    var heroBottom = heroSection.getBoundingClientRect().bottom;
    if (heroBottom < window.innerHeight * 0.4) {
      quickBar.classList.add('is-visible');
    } else {
      quickBar.classList.remove('is-visible');
    }
  }

  // Build the lookup key from the selected control in each option group, in option order
  function currentKey() {
    if (!optionWrap) return null;
    var groups = optionWrap.querySelectorAll('.pdp-hero__option');
    var parts = [];
    for (var i = 0; i < groups.length; i++) {
      var pill = groups[i].querySelector('.pdp-hero__pill-btn.is-selected');
      if (pill) { parts.push(pill.getAttribute('data-option-value')); continue; }
      var dd = groups[i].querySelector('[data-option-select]');
      if (dd) { parts.push(dd.value); continue; }
      return null;
    }
    return parts.join('~~');
  }

  function applyVariant(v) {
    if (!v) return;
    if (idInput) idInput.value = v.id;
    if (priceEl && v.priceFmt) priceEl.textContent = v.priceFmt;

    if (compareEl) {
      if (v.compareFmt) {
        compareEl.textContent = v.compareFmt;
        compareEl.style.display = '';
      } else {
        compareEl.textContent = '';
        compareEl.style.display = 'none';
      }
    }
    if (salePillEl) salePillEl.style.display = v.compareFmt ? '' : 'none';

    if (btn && btnLabel && btnPriceEl) {
      if (v.available) {
        btn.disabled = false;
        btn.type = 'submit';
        btn.name = 'add';
        btn.classList.remove('pdp-hero__enrol-btn--disabled');
        btnLabel.textContent = enrolLabel;
        btnPriceEl.textContent = ' · ' + v.priceFmt + ' ' + currency;
        btnPriceEl.style.display = '';
      } else {
        btn.disabled = true;
        btn.type = 'button';
        btn.removeAttribute('name');
        btn.classList.add('pdp-hero__enrol-btn--disabled');
        btnLabel.textContent = 'Sold Out';
        btnPriceEl.textContent = '';
        btnPriceEl.style.display = 'none';
      }
    }

    syncQuickBarPrice();
  }

  if (optionWrap) {
    optionWrap.addEventListener('click', function (e) {
      var pill = e.target.closest('.pdp-hero__pill-btn');
      if (!pill) return;
      var group = pill.closest('.pdp-hero__option');
      group.querySelectorAll('.pdp-hero__pill-btn').forEach(function (p) {
        p.classList.remove('is-selected');
        p.setAttribute('aria-checked', 'false');
      });
      pill.classList.add('is-selected');
      pill.setAttribute('aria-checked', 'true');

      var key = currentKey();
      if (key && variantMap[key]) applyVariant(variantMap[key]);
    });

    optionWrap.addEventListener('change', function (e) {
      if (!e.target.closest('[data-option-select]')) return;
      var key = currentKey();
      if (key && variantMap[key]) applyVariant(variantMap[key]);
    });
  }

  if (quickBtn && btn) {
    quickBtn.addEventListener('click', function () {
      btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(function () {
        if (!btn.disabled) {
          btn.click();
        }
      }, 400);
    });
  }

  syncQuickBarPrice();
  updateDesktopQuickBar();
  syncQuickBarSpace();

  window.addEventListener('scroll', updateDesktopQuickBar, { passive: true });
  window.addEventListener('resize', function () {
    updateDesktopQuickBar();
    syncQuickBarSpace();
  });
  window.addEventListener('load', syncQuickBarSpace);
});
</script>

<style>
