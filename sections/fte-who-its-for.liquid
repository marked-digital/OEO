{%- comment -%}
  Full-Time Enrolment · Who it's for (Wireframe A · S2)
  The qualification gate: four short icon cards, no paragraphs. Each item is a
  block with an icon, title, and one supporting line. Styled to the PDP grammar
  (grey eyebrow, indigo heading, lavender cards).
{%- endcomment -%}

<section class="fte-who" aria-labelledby="fte-who-heading-{{ section.id }}">
  <div class="fte-who__inner">

    <div class="fte-who__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fte-who__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="fte-who__heading" id="fte-who-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="fte-who__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <div class="fte-who__card" {{ block.shopify_attributes }}>
            <span class="fte-who__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'cap' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10L12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/></svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
                {%- when 'globe' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2c2.5 2.6 4 6.2 4 10s-1.5 7.4-4 10c-2.5-2.6-4-6.2-4-10s1.5-7.4 4-10z"/></svg>
                {%- when 'calendar' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
              {%- endcase -%}
            </span>
            {%- if block.settings.title != blank -%}
              <div class="fte-who__card-title">{{ block.settings.title | escape }}</div>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="fte-who__card-body">{{ block.settings.body | escape }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
.fte-who {
  background: #ffffff;
  padding: clamp(48px, 7vw, 80px) 0;
}

.fte-who__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}

.fte-who__head {
  max-width: 620px;
  margin-bottom: 36px;
}

.fte-who__eyebrow {
  margin: 0 0 10px;
  font-size: 11px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #98a0bf;
}

.fte-who__heading {
  margin: 0;
  font-size: clamp(2rem, 3vw, 2.45rem);
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: #24367a;
}

.fte-who__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 18px;
}

.fte-who__card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  background: var(--light, #f0f1f5);
  border-radius: 16px;
  padding: 26px 24px;
}

.fte-who__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #F0C418;
  color: #24367a;
}

.fte-who__icon svg {
  width: 22px;
  height: 22px;
  display: block;
}

.fte-who__card-title {
  font-size: 17px;
  font-weight: 700;
  color: #24367a;
  line-height: 1.3;
}

.fte-who__card-body {
  font-size: 14px;
  line-height: 1.55;
  color: #6f789f;
}

@media (max-width: 767px) {
  .fte-who__inner {
    padding: 0 16px;
  }
}
</style>

{% schema %}
{
  "name": "FTE Who It's For",
  "tag": "section",
  "class": "fte-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Who it's for"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "If you need a school year, you qualify."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "cap", "label": "Graduation cap" },
            { "value": "check", "label": "Check circle" },
            { "value": "globe", "label": "Globe" },
            { "value": "calendar", "label": "Calendar" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "No prerequisite to apply"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Supporting line",
          "default": "Placement is confirmed at your free guidance session."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "FTE Who It's For",
      "blocks": [
        { "type": "item", "settings": { "icon": "cap", "title": "Every grade, plus adult learners", "body": "Grades 9 to 12, and adults finishing their OSSD." } },
        { "type": "item", "settings": { "icon": "check", "title": "No prerequisite to apply", "body": "Placement is confirmed at your free guidance session." } },
        { "type": "item", "settings": { "icon": "globe", "title": "Canadian and international students", "body": "Study fully online from anywhere in the world." } },
        { "type": "item", "settings": { "icon": "calendar", "title": "Start any day of the year", "body": "No September intake, no cohort to wait for." } }
      ]
    }
  ]
}
{% endschema %}
