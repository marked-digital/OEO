{%- comment -%}
  Virtual Classroom · Google Classroom for Parents
  Styled to the enhanced PDP: lavender band (pdp-testimonials bg), left-aligned
  PDP eyebrow/heading recipe, pdp-tcard white cards with gold rule accent.
  Claims note from the handoff: confirm guardian email summaries are enabled
  in OEO's Google Workspace before this ships.
{%- endcomment -%}

<section class="vc-parents" aria-labelledby="vc-parents-heading-{{ section.id }}">
  <div class="vc-parents__inner">

    <p class="vc-parents__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="vc-parents__heading" id="vc-parents-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p class="vc-parents__intro">{{ section.settings.intro | escape }}</p>

    {%- if section.blocks.size > 0 -%}
      <div class="vc-parents__cards" id="vc-parents-cards-{{ section.id }}">
        {%- for block in section.blocks -%}
          <div class="vc-parents__card" {{ block.shopify_attributes }}>
            <div class="vc-parents__card-rule" aria-hidden="true"></div>
            <h3 class="vc-parents__card-title">{{ block.settings.title | escape }}</h3>
            <p class="vc-parents__card-body">{{ block.settings.body | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="vc-parents__dots" id="vc-parents-dots-{{ section.id }}">
          {%- for block in section.blocks -%}
            <button type="button" class="vc-parents__dot{% if forloop.first %} is-active{% endif %}" data-vc-dot="{{ forloop.index0 }}" aria-label="Go to card {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</section>

<style>
.vc-parents {
  background: #f2f1f6;
  padding: 64px 0 72px;
}

.vc-parents__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}

/* PDP eyebrow recipe (pdp-t-eyebrow) */
.vc-parents__eyebrow {
  margin: 0 0 10px;
  font-size: 11px;
  line-height: 1.4;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #9199bb;
}

/* PDP heading recipe (pdp-t-heading) */
.vc-parents__heading {
  margin: 0 0 12px;
  font-size: clamp(1.75rem, 3vw, 2.5rem);
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #1a2560;
}

/* PDP body recipe (pdp-guidance__body) */
.vc-parents__intro {
  margin: 0 0 36px;
  font-size: 0.97rem;
  line-height: 1.7;
  color: #6b7280;
  max-width: 60ch;
}

.vc-parents__cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  gap: 20px;
}

/* pdp-tcard treatment */
.vc-parents__card {
  background: #ffffff;
  border: 1px solid rgba(30, 42, 94, 0.1);
  border-radius: 16px;
  box-shadow: 0 2px 16px rgba(30, 42, 94, 0.06);
  padding: 28px;
}

.vc-parents__card-rule {
  width: 34px;
  height: 4px;
  background: #F0C417;
  border-radius: 2px;
  margin-bottom: 18px;
}

/* PDP card title/body sizes (pdp-tname / pdp-faqs__answer) */
.vc-parents__card-title {
  margin: 0 0 10px;
  font-size: 15px;
  font-weight: 700;
  color: #1e2a5e;
}

.vc-parents__card-body {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.7;
  color: #4b5563;
}

/* Dots (pdp-tdot grammar), mobile carousel only */
.vc-parents__dots {
  display: none;
}

@media (max-width: 767px) {
  /* Swipeable card carousel with next-card peek */
  .vc-parents__cards {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 14px;
    margin: 0 -32px;
    padding: 4px 32px 8px;
    scrollbar-width: none;
  }

  .vc-parents__cards::-webkit-scrollbar {
    display: none;
  }

  .vc-parents__card {
    flex: 0 0 82%;
    scroll-snap-align: center;
  }

  .vc-parents__dots {
    display: flex;
    gap: 7px;
    justify-content: center;
    margin-top: 16px;
  }

  .vc-parents__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(30, 42, 94, 0.2);
    cursor: pointer;
    transition: all 300ms ease;
    border: none;
    padding: 0;
  }

  .vc-parents__dot.is-active {
    background: #1e2a5e;
    transform: scale(1.3);
  }
}

@media (max-width: 580px) {
  .vc-parents {
    padding: 40px 0 56px;
  }
  .vc-parents__inner {
    padding: 0 20px;
  }
  .vc-parents__cards {
    margin: 0 -20px;
    padding: 4px 20px 8px;
  }
}
</style>

<script>
  (function () {
    var scroller = document.getElementById('vc-parents-cards-{{ section.id }}');
    var dotsWrap = document.getElementById('vc-parents-dots-{{ section.id }}');
    if (!scroller || !dotsWrap) return;
    var dots = dotsWrap.querySelectorAll('[data-vc-dot]');
    var cards = scroller.querySelectorAll('.vc-parents__card');

    function setActive(i) {
      dots.forEach(function (d, j) { d.classList.toggle('is-active', j === i); });
    }

    // Positions measured with rects: offsetLeft would be body-relative here
    // because neither the scroller nor its ancestors are positioned.
    function cardLeft(card) {
      return card.getBoundingClientRect().left - scroller.getBoundingClientRect().left + scroller.scrollLeft;
    }

    var ticking = false;
    scroller.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        var center = scroller.scrollLeft + scroller.clientWidth / 2;
        var best = 0;
        var bestDist = Infinity;
        cards.forEach(function (card, i) {
          var cardCenter = cardLeft(card) + card.offsetWidth / 2;
          var dist = Math.abs(cardCenter - center);
          if (dist < bestDist) { bestDist = dist; best = i; }
        });
        setActive(best);
      });
    }, { passive: true });

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        var card = cards[i];
        scroller.scrollTo({ left: cardLeft(card) - (scroller.clientWidth - card.offsetWidth) / 2, behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "VC For Parents",
  "tag": "section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "For Parents"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Google Classroom keeps you in the loop"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "You see the same course your child sees. No portals to learn, no waiting for report cards."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Weekly guardian summaries"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Sign up for guardian email summaries and get a weekly digest of upcoming work and anything missing."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "VC For Parents",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Weekly guardian summaries",
            "body": "Sign up for guardian email summaries and get a weekly digest of upcoming work and anything missing."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Progress you can see",
            "body": "Follow along throughout the course. Lessons, marks, and returned work are visible as they happen, not just at report time."
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "A direct line to the teacher",
            "body": "You can reach your child's teacher directly. Questions are answered within 24 hours, Monday to Friday."
          }
        }
      ]
    }
  ]
}
{% endschema %}
