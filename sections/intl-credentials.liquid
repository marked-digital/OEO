{% render 'intl-css' %}
<section class="oeo-lp lp-cred">
  <div class="lp-inner">
    <div class="lp-cred__head">
      <div class="lp-cred__anchor">
        {% if section.settings.anchor_eyebrow != blank %}<span class="lp-cred__seal-ey">{{ section.settings.anchor_eyebrow }}</span>{% endif %}
        {% if section.settings.anchor_label != blank %}<span class="lp-cred__seal-lead">{{ section.settings.anchor_label }}</span>{% endif %}
      </div>
    </div>
    <div class="lp-cred__items">
      {% for block in section.blocks %}
        <div class="lp-cred__item" {{ block.shopify_attributes }}>
          <span class="lp-cred__chip">{% render 'intl-icon', icon: block.settings.icon, size: 24 %}</span>
          <div class="lp-cred__txt">
            <div class="lp-cred__lead">{{ block.settings.lead }}</div>
            <div class="lp-cred__sub">{{ block.settings.sub }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Intl • Credentials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "anchor_eyebrow", "label": "Anchor eyebrow", "default": "Accredited" },
    { "type": "text", "id": "anchor_label", "label": "Anchor label", "default": "Ontario private school" }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "credential",
      "name": "Credential",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "check",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "chat", "label": "Chat" },
            { "value": "noexam", "label": "Document" },
            { "value": "cap", "label": "Grad cap" },
            { "value": "award", "label": "Award" },
            { "value": "globe", "label": "Globe" },
            { "value": "pace", "label": "Clock" }
          ] },
        { "type": "text", "id": "lead", "label": "Lead", "default": "Ministry-Inspected" },
        { "type": "text", "id": "sub", "label": "Sub", "default": "BSID #882902" }
      ]
    }
  ],
  "presets": [{
    "name": "Intl • Credentials",
    "blocks": [
      { "type": "credential", "settings": { "icon": "check",  "lead": "Ministry-Inspected",         "sub": "BSID #882902" } },
      { "type": "credential", "settings": { "icon": "chat",   "lead": "Taught by OCT teachers",     "sub": "Ontario Certified Teachers" } },
      { "type": "credential", "settings": { "icon": "noexam", "lead": "Official OSSD credits",      "sub": "and transcripts issued" } },
      { "type": "credential", "settings": { "icon": "cap",    "lead": "Recognized by universities", "sub": "across Canada and internationally" } }
    ]
  }]
}
{% endschema %}
