{%- comment -%}
  PDP · Virtual Classroom tour teaser
  A compact indigo band for product pages that hands shoppers to the
  /pages/virtual-classroom tour. Sits directly below the "How it works"
  steps on the product template. Dark treatment intentionally mirrors the
  VC page hero so the link "smells" like its destination.

  Add once to the product template in the theme editor; it then appears on
  every product using that template.
{%- endcomment -%}

<section class="vc-teaser" aria-labelledby="vc-teaser-heading-{{ section.id }}">
  <div class="vc-teaser__inner">
    <div class="vc-teaser__card vc-teaser__card--{{ section.settings.card_style | default: 'light' }}">

      <div class="vc-teaser__content">
        <p class="vc-teaser__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="vc-teaser__heading" id="vc-teaser-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p class="vc-teaser__body">{{ section.settings.body | escape }}</p>
        <div class="vc-teaser__cta-row">
          <a href="{{ section.settings.button_url | default: '/pages/virtual-classroom' }}" class="vc-teaser__btn" target="_blank" rel="noopener">
            {{ section.settings.button_label | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          {%- if section.settings.meta_line != blank -%}
            <span class="vc-teaser__meta">{{ section.settings.meta_line | escape }}</span>
          {%- endif -%}
        </div>
      </div>

      <a
        href="{{ section.settings.button_url | default: '/pages/virtual-classroom' }}"
        class="vc-teaser__media"
        target="_blank"
        rel="noopener"
        tabindex="-1"
        aria-hidden="true"
      >
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source media="(max-width: 580px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
          {%- endif -%}
          {%- if section.settings.image != blank -%}
            <img
              class="vc-teaser__img"
              src="{{ section.settings.image | image_url: width: 1000 }}"
              alt=""
              loading="lazy"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
            >
          {%- elsif section.settings.image_asset != blank -%}
            <img
              class="vc-teaser__img"
              src="{{ section.settings.image_asset | asset_url }}"
              alt=""
              loading="lazy"
            >
          {%- endif -%}
        </picture>
        <span class="vc-teaser__media-badge">
          <svg viewBox="0 0 24 24" fill="currentColor" width="11" height="11" aria-hidden="true"><polygon points="6 4 20 12 6 20"/></svg>
          {{ section.settings.badge_label | escape }}
        </span>
      </a>

    </div>
  </div>
</section>

<style>
.vc-teaser {
  background: #ffffff;
  padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px;
}

.vc-teaser__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}

/* Indigo card mirrors the VC page hero gradient */
.vc-teaser__card {
  display: flex;
  align-items: center;
  gap: clamp(24px, 4vw, 56px);
  background: linear-gradient(160deg, var(--color-dark, #1e2460) 0%, #2a3884 90%);
  border-radius: 22px;
  padding: clamp(28px, 4vw, 48px);
  overflow: hidden;
  position: relative;
}

.vc-teaser__content {
  flex: 1 1 55%;
  min-width: 0;
}

/* Light variant: lavender card, indigo text. Breaks the double-indigo
   stack when the section sits directly below the dark No Exam block. */
.vc-teaser__card--light {
  background: #F2F1F6;
  border: 1px solid rgba(30, 42, 94, 0.08);
}

.vc-teaser__card--light .vc-teaser__eyebrow {
  color: #2B3886;
}

.vc-teaser__card--light .vc-teaser__heading {
  color: #1a2560;
}

.vc-teaser__card--light .vc-teaser__body {
  color: rgba(30, 42, 94, 0.75);
}

.vc-teaser__card--light .vc-teaser__meta {
  color: rgba(30, 42, 94, 0.6);
}

.vc-teaser__card--light .vc-teaser__media {
  border-color: rgba(30, 42, 94, 0.12);
  box-shadow: 0 18px 40px rgba(17, 33, 89, 0.16);
}

/* PDP eyebrow recipe · gold on dark */
.vc-teaser__eyebrow {
  margin: 0 0 10px;
  font-size: 11px;
  line-height: 1.4;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #f0c417;
}

.vc-teaser__heading {
  margin: 0 0 12px;
  font-size: clamp(1.5rem, 2.4vw, 2.05rem);
  line-height: 1.12;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #ffffff;
}

.vc-teaser__body {
  margin: 0 0 22px;
  font-size: 15px;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.78);
  max-width: 46ch;
}

.vc-teaser__cta-row {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

/* Gold pill (PDP button grammar) */
.vc-teaser__btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.95rem;
  font-weight: 700;
  text-decoration: none;
  padding: 13px 26px;
  border-radius: 999px;
  background: #F0C417;
  color: #1e2a5e;
  transition: background 180ms ease, transform 180ms ease;
}

.vc-teaser__btn:hover {
  background: #c49b00;
  color: #1e2a5e;
  transform: translateY(-1px);
}

.vc-teaser__btn svg {
  flex: none;
}

.vc-teaser__meta {
  font-size: 13px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.6);
}

/* Screenshot side */
.vc-teaser__media {
  flex: 1 1 45%;
  min-width: 0;
  position: relative;
  display: block;
  border-radius: 14px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.22);
  box-shadow: 0 18px 40px rgba(10, 18, 55, 0.45);
}

.vc-teaser__media picture {
  display: block;
}

.vc-teaser__img {
  display: block;
  width: 100%;
  height: auto;
}

.vc-teaser__media-badge {
  position: absolute;
  left: 12px;
  bottom: 12px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 12px;
  border-radius: 999px;
  background: rgba(30, 36, 96, 0.85);
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
}

.vc-teaser__media-badge svg {
  color: #F0C417;
}

@media (max-width: 860px) {
  .vc-teaser__card {
    flex-direction: column-reverse;
    align-items: stretch;
    text-align: left;
  }
  .vc-teaser__media {
    flex: none;
  }
}

@media (max-width: 580px) {
  .vc-teaser {
    padding: {{ section.settings.padding_top | default: 56 | times: 0.7 | round }}px 0 {{ section.settings.padding_bottom | default: 56 | times: 0.7 | round }}px;
  }
  .vc-teaser__inner {
    padding: 0 20px;
  }
  .vc-teaser__card {
    padding: 22px 20px;
    border-radius: 18px;
  }
  .vc-teaser__body {
    font-size: 14px;
    margin-bottom: 18px;
  }
  .vc-teaser__btn {
    width: 100%;
    justify-content: center;
  }
  .vc-teaser__cta-row {
    justify-content: center;
  }
  .vc-teaser__meta {
    width: 100%;
    text-align: center;
  }
}
</style>

{% schema %}
{
  "name": "VC Tour Teaser",
  "tag": "section",
  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inside the Virtual Classroom"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See exactly what you're getting."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Take the tour of a real OEO course. The dashboard, the lessons, the interactive videos, and real teacher feedback. Every screen is the real thing."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Take the Tour"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "info": "Defaults to /pages/virtual-classroom if left empty."
    },
    {
      "type": "text",
      "id": "meta_line",
      "label": "Meta line beside the button",
      "default": "75-second video · 8 real screens"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Screenshot",
      "info": "Use the Step 1 dashboard crop, same as the VC page hero poster."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Screenshot (mobile)",
      "info": "Optional. A tighter, squarer crop shown on screens under 580px. Leave empty to reuse the main screenshot."
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Screenshot fallback asset filename",
      "default": "vc-step-1-dashboard.png",
      "info": "Used only when no screenshot is selected above."
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge on the screenshot",
      "default": "Watch the walkthrough"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "light", "label": "Light (lavender)" },
        { "value": "indigo", "label": "Indigo" }
      ],
      "default": "light",
      "info": "Use Light when the section sits below a dark block like No Exam."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "VC Tour Teaser"
    }
  ]
}
{% endschema %}
