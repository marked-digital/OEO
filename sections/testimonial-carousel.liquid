<section class="oeo-testimonials">
  <div class="oeo-testimonial-wrapper">

    {%- assign testimonials = shop.metaobjects.testimonial.values -%}

    <div class="oeo-testimonial-slider" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed }}">

      {%- for t in testimonials -%}
        <div class="oeo-testimonial-slide{% if forloop.first %} active{% endif %}">
          <div class="oeo-testimonial-card">

            <div class="oeo-quote-watermark">"</div>

            <div class="oeo-stars">
              {%- for i in (1..t['rating']) -%}★{%- endfor -%}
            </div>

            <blockquote>{{ t['quote'] | escape }}</blockquote>

            {%- if t['reviewer_detail'] != blank -%}
              <div class="oeo-outcome">{{ t['reviewer_detail'] | escape }}</div>
            {%- endif -%}

            {%- if t['photo'] != blank -%}
              <img
                src="{{ t['photo'] | image_url: width: 200 }}"
                alt="{{ t['reviewer_name'] | escape }}"
                width="90"
                height="90"
                class="oeo-avatar"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}

            <div class="oeo-name">{{ t['reviewer_name'] | escape }}</div>

            {%- if t['badge_label'] != blank -%}
              <div class="oeo-verified">✔ {{ t['badge_label'] | escape }}</div>
            {%- endif -%}

          </div>
        </div>
      {%- endfor -%}

    </div>

    <div class="oeo-dots"></div>

    <div class="oeo-controls">
      <button class="oeo-prev">‹</button>
      <button class="oeo-next">›</button>
    </div>

  </div>
</section>

<style>
.oeo-testimonials {
  position: relative;
  padding: 60px 20px;
  background: linear-gradient(180deg, #eef1ff 0%, #FFFFFF 100%) !important;
  overflow: hidden;
}

.oeo-testimonial-wrapper {
  max-width: 80%;
  margin: 0 auto;
  text-align: center;
  position: relative;
}

.oeo-testimonial-wrapper::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 900px;
  height: 900px;
  transform: translate(-50%, -50%);
  background: radial-gradient(circle, rgba(47,58,120,0.08) 0%, rgba(47,58,120,0.04) 40%, rgba(47,58,120,0) 70%);
  z-index: 0;
  pointer-events: none;
}

.oeo-testimonial-slide {
  display: none;
  transition: opacity .4s ease, transform .4s ease;
}

.oeo-testimonial-slider {
  position: relative;
  transition: height .35s ease;
}

.oeo-testimonial-slide.active {
  display: block;
}

.oeo-testimonial-card {
  position: relative;
  padding: 60px 40px;
  border-radius: 24px;
  backdrop-filter: blur(12px);
  background: rgba(255,255,255,.55);
  box-shadow: 0 30px 60px rgba(0,0,0,.15);
  z-index: 1;
}

.oeo-quote-watermark {
  position: absolute;
  top: 10px;
  left: 30px;
  font-size: 120px;
  opacity: 0.3;
  font-weight: bold;
}

.oeo-stars {
  color: #f0c417;
  font-size: 30px;
  letter-spacing: 6px;
  margin-bottom: 30px;
}

blockquote {
  font-size: 20px;
  line-height: 1.3;
  max-width: 850px;
  margin: 0 auto 35px;
}

.oeo-outcome {
  display: inline-block;
  padding: 10px 18px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 15px;
  line-height: 1.3;
  background: rgba(47,58,120,0.08);
  color: #2f3a78;
  margin-bottom: 25px;
  letter-spacing: .3px;
}

.oeo-avatar {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  object-fit: cover;
  margin: 0 auto 12px;
}

.oeo-name { font-weight: 600; }

.oeo-verified {
  font-size: 14px;
  opacity: 0.7;
  margin-top: 4px;
}

.oeo-controls {
  margin-top: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 25px;
}

.oeo-controls button {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  border: none;
  background: white;
  box-shadow: 0 10px 25px rgba(0,0,0,.15);
  font-size: 42px;
  cursor: pointer;
  transition: all .2s ease;
}

.oeo-controls button:hover {
  transform: translateY(-3px);
  box-shadow: 0 18px 35px rgba(0,0,0,.2);
}

.oeo-dots {
  margin-top: 30px;
  display: flex;
  justify-content: center;
  gap: 12px;
  position: relative;
  z-index: 2;
}

.oeo-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(47,58,120,0.25);
  cursor: pointer;
  transition: all .3s ease;
}

.oeo-dot.active {
  background: #2f3a78;
  transform: scale(1.2);
}

@media (min-width: 992px) {
  .oeo-controls {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    justify-content: space-between;
    pointer-events: none;
  }
  .oeo-controls button { pointer-events: auto; }
  .oeo-prev { margin-left: -80px; }
  .oeo-next { margin-right: -80px; }
}

@media (max-width: 768px) {
  .oeo-quote-watermark { font-size: 70px; top: 0; left: 15px; opacity: 0.15; }
  .oeo-testimonial-card { padding: 50px 25px; }
  .oeo-stars { font-size: 24px; }
  blockquote { font-size: 14px; line-height: 1.3; max-width: 850px; margin: 0 auto 35px; }
  .oeo-outcome { font-size: 14px; background: rgba(47,58,120,0.08); color: #2f3a78; margin-bottom: 15px; letter-spacing: .3px; }
  .oeo-avatar { width: 75px; height: 75px; }
}

@media (max-width: 480px) {
  .oeo-quote-watermark { display: none; }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const slider = document.querySelector(".oeo-testimonial-slider");
  const slides = document.querySelectorAll(".oeo-testimonial-slide");
  const next = document.querySelector(".oeo-next");
  const prev = document.querySelector(".oeo-prev");
  const dotsContainer = document.querySelector(".oeo-dots");

  let current = 0;
  let autoplay = slider.dataset.autoplay === "true";
  let speed = parseInt(slider.dataset.speed) || 5000;
  let interval;

  slides.forEach((_, index) => {
    const dot = document.createElement("div");
    dot.classList.add("oeo-dot");
    if (index === 0) dot.classList.add("active");
    dot.addEventListener("click", () => { current = index; showSlide(current); resetAutoplay(); });
    dotsContainer.appendChild(dot);
  });

  const dots = document.querySelectorAll(".oeo-dot");

  function updateDots() {
    dots.forEach(dot => dot.classList.remove("active"));
    dots[current].classList.add("active");
  }

  function setDynamicHeight() {
    if (window.innerWidth <= 768) { slider.style.height = "auto"; return; }
    let tallest = 0;
    slides.forEach(slide => {
      slide.style.display = "block";
      const height = slide.offsetHeight;
      if (height > tallest) tallest = height;
      slide.style.display = "";
    });
    slider.style.height = tallest + "px";
    slides.forEach((slide, index) => {
      slide.style.display = index === current ? "block" : "none";
    });
  }

  function showSlide(index) {
    slides.forEach(slide => { slide.classList.remove("active"); slide.style.display = "none"; });
    slides[index].classList.add("active");
    slides[index].style.display = "block";
    updateDots();
  }

  function nextSlide() { current = (current + 1) % slides.length; showSlide(current); }
  function prevSlide() { current = (current - 1 + slides.length) % slides.length; showSlide(current); }

  next.addEventListener("click", () => { nextSlide(); resetAutoplay(); });
  prev.addEventListener("click", () => { prevSlide(); resetAutoplay(); });

  function startAutoplay() { if (autoplay) interval = setInterval(nextSlide, speed); }
  function stopAutoplay() { clearInterval(interval); }
  function resetAutoplay() { stopAutoplay(); startAutoplay(); }

  slider.addEventListener("mouseenter", stopAutoplay);
  slider.addEventListener("mouseleave", startAutoplay);
  startAutoplay();

  let startX = 0;
  slider.addEventListener("touchstart", e => { startX = e.touches[0].clientX; });
  slider.addEventListener("touchend", e => {
    let endX = e.changedTouches[0].clientX;
    if (startX - endX > 50) { nextSlide(); resetAutoplay(); }
    if (endX - startX > 50) { prevSlide(); resetAutoplay(); }
  });

  function imagesLoaded() {
    const images = slider.querySelectorAll("img");
    let loaded = 0;
    if (images.length === 0) { setDynamicHeight(); return; }
    images.forEach(img => {
      if (img.complete) { loaded++; if (loaded === images.length) setDynamicHeight(); }
      else { img.addEventListener("load", () => { loaded++; if (loaded === images.length) setDynamicHeight(); }); }
    });
  }

  imagesLoaded();
  window.addEventListener("resize", setDynamicHeight);
});
</script>

{% schema %}
{
  "name": "Testimonial Carousel",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Auto Rotate",
      "default": true
    },
    {
      "type": "number",
      "id": "autoplay_speed",
      "label": "Auto Rotate Speed (ms)",
      "default": 5000
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f9fc"
    }
  ],
  "presets": [
    {
      "name": "Premium Testimonial Carousel"
    }
  ]
}
{% endschema %}