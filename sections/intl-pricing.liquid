{% render 'intl-css' %}
<section class="oeo-lp lp-sec lp-price" id="pricing">
  <div class="lp-inner">
    <div class="lp-price__grid">
      <div>
        {% if section.settings.eyebrow != blank %}<div class="lp-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
        <h2 class="lp-price__h">{{ section.settings.heading }}</h2>
        {% if section.settings.body != blank %}<div class="lp-price__p">{{ section.settings.body }}</div>{% endif %}
        {% if section.settings.methods_label != blank %}<div class="lp-price__methods-label">{{ section.settings.methods_label }}</div>{% endif %}
        <div class="lp-price__methods">
          {% assign methods = section.settings.methods | split: ',' %}
          {% for m in methods %}<span class="lp-price__chip">{{ m | strip }}</span>{% endfor %}
        </div>
      </div>
      <div class="lp-card lp-price__table">
        <div class="lp-price__thead"><span>{{ section.settings.col_course }}</span><span>{{ section.settings.col_price }}</span></div>
        {%- assign kw = section.settings.intl_keyword | default: 'International' | downcase -%}
        {% for block in section.blocks %}
          {%- assign product = block.settings.product -%}
          {%- if product != blank -%}
            {%- assign intl_variant = nil -%}
            {%- for v in product.variants -%}
              {%- assign vtitle = v.title | downcase -%}
              {%- if vtitle contains kw -%}{%- assign intl_variant = v -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
            {%- assign price_variant = intl_variant | default: product.selected_or_first_available_variant -%}
            {%- assign code = product.metafields.custom.course_code -%}
            {%- assign course_url = product.url -%}
            {%- if price_variant -%}{%- assign course_url = product.url | append: '?variant=' | append: price_variant.id -%}{%- endif -%}
            <div class="lp-price__row" {{ block.shopify_attributes }}>
              <a class="lp-price__rowinfo" href="{{ course_url }}">
                {%- if code != blank -%}<div class="lp-price__code">{{ code }}</div>{%- endif -%}
                <div class="lp-price__name">{{ product.title }}</div>
              </a>
              <div class="lp-price__rowend">
                <div class="lp-price__amt">{{ price_variant.price | money }}</div>
                {%- if section.settings.row_cta_label != blank -%}
                  <a class="button button--sm lp-price__cta" href="{{ course_url }}">{{ section.settings.row_cta_label }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {% endfor %}
        {% if section.settings.show_discount and section.settings.discount != blank %}
          <div class="lp-price__disc">
            <span class="ico">{% render 'intl-icon', icon: 'check', size: 16 %}</span>
            <span class="t">{{ section.settings.discount }}</span>
          </div>
        {% endif %}
        {% if section.settings.explore_label != blank %}
          <a class="lp-price__textcta" href="{{ section.settings.explore_url | default: '#' }}">
            <span class="lp-price__textcta-t">{{ section.settings.explore_label }}</span>
            {% render 'intl-icon', icon: 'arrow', size: 16 %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Intl • Pricing",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Transparent pricing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose the Ontario courses you need." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Browse Grade 9 to 12 courses across every subject, each developed and taught by an Ontario Certified Teacher. Enrol in as many as you need and study at your own pace, from anywhere in the world.</p>" },
    { "type": "text", "id": "methods_label", "label": "Payment methods label", "default": "Accepted payment methods" },
    { "type": "text", "id": "methods", "label": "Payment chips (comma separated)", "default": "VISA, Mastercard, AMEX, Apple Pay, Google Pay, Shop Pay" },
    { "type": "header", "content": "Pricing source" },
    { "type": "text", "id": "intl_keyword", "label": "International variant keyword", "default": "International", "info": "Shows the price of the variant whose title contains this word (case-insensitive)." },
    { "type": "text", "id": "row_cta_label", "label": "Row button label", "default": "Learn more", "info": "Per-course button linking to the product (international variant pre-selected). Leave blank to hide." },
    { "type": "text", "id": "col_course", "label": "Table column 1", "default": "Course" },
    { "type": "text", "id": "col_price", "label": "Table column 2", "default": "Price (CAD)" },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount footer", "default": true },
    { "type": "text", "id": "discount", "label": "Discount footer", "default": "Enrol in 2+ courses and save $150 at checkout." },
    { "type": "text", "id": "explore_label", "label": "Explore link label", "default": "Explore All Courses" },
    { "type": "url", "id": "explore_url", "label": "Explore link" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Course",
      "settings": [
        { "type": "product", "id": "product", "label": "Course product" }
      ]
    }
  ],
  "presets": [{
    "name": "Intl • Pricing",
    "blocks": [
      { "type": "row" },
      { "type": "row" },
      { "type": "row" },
      { "type": "row" }
    ]
  }]
}
{% endschema %}
