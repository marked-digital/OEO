{%- comment -%}
  Full-Time Enrolment · Placement helper (Wireframe A · S6)
  For transfer students and adult learners who cannot self-select a grade card.
  Advisor-photo card, single guidance CTA. This is a distinct section from the
  reused PDP Guidance CTA (which is limit: 1 and closes the page at S8), so the
  page can carry both the placement helper here and the closing CTA below.
{%- endcomment -%}

<section class="fte-placement" aria-labelledby="fte-placement-heading-{{ section.id }}">
  <div class="fte-placement__inner">
    <div class="fte-placement__card">

      <div class="fte-placement__avatar">
        {%- if section.settings.advisor_image != blank -%}
          <img
            src="{{ section.settings.advisor_image | image_url: width: 208 }}"
            alt="{{ section.settings.advisor_image.alt | default: 'OEO guidance advisor' | escape }}"
            width="104"
            height="104"
            loading="lazy"
            decoding="async"
          >
        {%- else -%}
          <div class="fte-placement__avatar-ph" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <circle cx="11" cy="8" r="4"/><path d="M3 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

      <div class="fte-placement__text">
        <h2 class="fte-placement__heading" id="fte-placement-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.body != blank -%}
          <p class="fte-placement__body">{{ section.settings.body | escape }}</p>
        {%- endif -%}
        <div class="fte-placement__cta-row">
          {%- if section.settings.button_label != blank -%}
            <a class="fte-placement__btn" href="{{ section.settings.button_url }}"{% if section.settings.button_new_tab %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.proof_text != blank -%}
            <span class="fte-placement__proof">{{ section.settings.proof_text | escape }}</span>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.fte-placement {
  background: var(--light, #f0f1f5);
  padding: clamp(48px, 7vw, 80px) 0;
}

.fte-placement__inner {
  max-width: 940px;
  margin: 0 auto;
  padding: 0 32px;
}

.fte-placement__card {
  background: #ffffff;
  border-radius: 24px;
  box-shadow: 0 4px 14px rgba(16, 33, 88, 0.06), 0 12px 30px rgba(16, 33, 88, 0.08);
  padding: clamp(28px, 4vw, 48px);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 28px 40px;
}

.fte-placement__avatar {
  flex: 0 0 auto;
  width: 104px;
  height: 104px;
  border-radius: 50%;
  overflow: hidden;
  background: var(--light, #f0f1f5);
  border: 1.5px solid #d1d5db;
}

.fte-placement__avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.fte-placement__avatar-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
}

.fte-placement__text {
  flex: 1 1 340px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fte-placement__heading {
  margin: 0;
  font-size: clamp(1.6rem, 2.5vw, 2.1rem);
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: #24367a;
}

.fte-placement__body {
  margin: 0;
  font-size: 16px;
  line-height: 1.7;
  color: #6f789f;
  text-wrap: pretty;
}

.fte-placement__cta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  margin-top: 4px;
}

.fte-placement__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: #F0C417;
  color: #1e2a5e;
  font-weight: 700;
  font-size: 15px;
  padding: 14px 26px;
  border-radius: 999px;
  text-decoration: none;
  transition: background 180ms ease, transform 180ms ease;
}

.fte-placement__btn:hover {
  background: #c49b00;
  color: #1e2a5e;
  transform: translateY(-1px);
}

.fte-placement__proof {
  font-size: 13px;
  color: #8a91b4;
}

@media (max-width: 767px) {
  .fte-placement__inner {
    padding: 0 16px;
  }
}
</style>

{% schema %}
{
  "name": "FTE Placement Helper",
  "tag": "section",
  "class": "fte-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "advisor_image",
      "label": "Advisor photo",
      "info": "Circular crop, recommended 208x208px minimum."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure which grade? That's normal."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Transfer students and adult learners often land between grades. Your credit transfer evaluation determines where you start. Book a free guidance session and we map your remaining credits before you pay anything."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Book a Free Guidance Session"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open in a new tab",
      "default": false
    },
    {
      "type": "text",
      "id": "proof_text",
      "label": "Proof line",
      "default": "Parents and guardians are welcome."
    }
  ],
  "presets": [
    {
      "name": "FTE Placement Helper"
    }
  ]
}
{% endschema %}
