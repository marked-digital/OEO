{%- comment -%}
  Full-Time Enrolment · Your Year at OEO (Wireframe B, new section)
  A slotted grid of the year's credits: compulsory slots (labelled) and open
  elective slots (chosen with the counsellor). Compulsory course names default
  to a bracketed placeholder because compulsory-credit lists are drafted from
  the Ontario curriculum and verified by OEO before publish (claims audit).

  Each slot can be mapped to a real course product with the block's product
  picker (same convention as fte-grade-router). A mapped slot pulls in the
  product image and course code, and the whole card links to that product page.
  Slots with no product mapped keep the placeholder treatment above.

  Optional credit-pack toggle (Grade 12 only): a self-contained 6 / 7 / 8
  control that dims slots above the selected pack so the parent sees the pack
  difference. It is illustrative and independent of the buy box selector;
  turn it off on the Grade 9 to 11 products, which have a fixed 8-credit load.
{%- endcomment -%}

{%- assign img_style = section.settings.product_image_style | default: 'cover' -%}

<section
  class="fte-year"
  aria-labelledby="fte-year-heading-{{ section.id }}"
  data-fte-year
  data-default-pack="{{ section.settings.default_pack | default: 8 }}"
>
  <div class="fte-year__inner">

    <div class="fte-year__head">
      <div class="fte-year__head-text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="fte-year__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="fte-year__heading" id="fte-year-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.body != blank -%}
          <p class="fte-year__body">{{ section.settings.body | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_pack_toggle -%}
        <div class="fte-year__pack">
          <span class="fte-year__pack-label">{{ section.settings.pack_toggle_label | default: 'Credit pack' | escape }}</span>
          <div class="fte-year__pack-btns" role="group" aria-label="{{ section.settings.pack_toggle_label | default: 'Credit pack' | escape }}">
            {%- assign packs = '6,7,8' | split: ',' -%}
            {%- for p in packs -%}
              <button type="button" class="fte-year__pack-btn{% if p == section.settings.default_pack %} is-selected{% endif %}" data-pack="{{ p }}" aria-pressed="{% if p == section.settings.default_pack %}true{% else %}false{% endif %}">{{ p }} credits</button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="fte-year__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slot' -%}
          {%- assign slot_product = block.settings.product -%}

          {%- comment -%}
            Label resolution: a mapped product supplies its own name, so the
            shipped default labels ('Open slot', the bracketed TBC token) count
            as unset. A label typed by the merchant always wins.
          {%- endcomment -%}
          {%- assign slot_label = block.settings.title -%}
          {%- if slot_product != blank -%}
            {%- if slot_label == blank or slot_label == 'Open slot' or slot_label contains 'Course TBC' -%}
              {%- assign slot_label = slot_product.title -%}
            {%- endif -%}
          {%- endif -%}

          {%- assign slot_sub = block.settings.sublabel -%}
          {%- if slot_product != blank and slot_sub == blank -%}
            {%- assign slot_sub = slot_product.metafields.custom.course_code.value -%}
          {%- endif -%}

          <div
            class="fte-year__slot fte-year__slot--{{ block.settings.kind }}{% if slot_product != blank %} fte-year__slot--linked{% endif %}"
            data-pack-min="{{ block.settings.pack_min | default: 6 }}"
            {{ block.shopify_attributes }}
          >
            {%- if slot_product != blank and slot_product.featured_image and img_style == 'cover' -%}
              <div class="fte-year__media">
                <img
                  class="fte-year__media-img"
                  src="{{ slot_product.featured_image | image_url: width: 600 }}"
                  alt="{{ slot_product.featured_image.alt | default: slot_product.title | escape }}"
                  width="600"
                  height="262"
                  loading="lazy"
                  decoding="async"
                >
              </div>
            {%- endif -%}

            <div class="fte-year__slot-top">
              <span class="fte-year__slot-n">Credit {{ forloop.index }}</span>
              {%- if block.settings.kind == 'elective' -%}
                <span class="fte-year__tag fte-year__tag--elective">Elective</span>
              {%- else -%}
                <span class="fte-year__tag fte-year__tag--compulsory">Compulsory</span>
              {%- endif -%}
            </div>

            {%- if slot_product != blank -%}
              <div class="fte-year__slot-main">
                {%- if slot_product.featured_image and img_style == 'thumb' -%}
                  <img
                    class="fte-year__thumb"
                    src="{{ slot_product.featured_image | image_url: width: 160 }}"
                    alt="{{ slot_product.featured_image.alt | default: slot_product.title | escape }}"
                    width="160"
                    height="160"
                    loading="lazy"
                    decoding="async"
                  >
                {%- endif -%}
                <span class="fte-year__slot-text">
                  <a class="fte-year__slot-link" href="{{ slot_product.url }}">{{ slot_label | escape }}</a>
                  {%- if slot_sub != blank -%}
                    <span class="fte-year__slot-sub">{{ slot_sub | escape }}</span>
                  {%- endif -%}
                </span>
              </div>
              <span class="fte-year__slot-cta" aria-hidden="true">{{ section.settings.product_cta_label | default: 'View course' | escape }} <span>→</span></span>

            {%- elsif block.settings.kind == 'elective' -%}
              <span class="fte-year__slot-label">{{ slot_label | default: 'Open slot' | escape }}</span>
              {%- if slot_sub != blank -%}
                <span class="fte-year__slot-sub">{{ slot_sub | escape }}</span>
              {%- endif -%}

            {%- else -%}
              <span class="fte-year__token">{{ slot_label | default: '[ Course TBC · pending verification ]' | escape }}</span>
            {%- endif -%}

            <div class="fte-year__lock" aria-hidden="true">
              <span class="fte-year__lock-label"></span>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="fte-year__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}

  </div>
</section>

<style>
.fte-year {
  background: var(--light, #f0f1f5);
  padding: clamp(20px, 7vw, 40px) 0;
}

.fte-year__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}

.fte-year__head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 32px;
}

.fte-year__head-text {
  max-width: 600px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fte-year__eyebrow {
  margin: 0;
  font-size: 11px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #98a0bf;
}

.fte-year__heading {
  margin: 0;
  font-size: clamp(2rem, 3vw, 2.45rem);
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: #24367a;
}

.fte-year__body {
  margin: 0;
  font-size: 16px;
  line-height: 1.7;
  color: #6f789f;
  text-wrap: pretty;
}

.fte-year__pack {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.fte-year__pack-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #98a0bf;
}

.fte-year__pack-btns {
  display: flex;
  gap: 8px;
}

.fte-year__pack-btn {
  padding: 10px 16px;
  border-radius: 10px;
  border: 1.5px solid rgba(36, 54, 122, 0.25);
  background: #ffffff;
  color: #24367a;
  font-family: inherit;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: border-color 120ms ease, background 120ms ease, color 120ms ease;
}

.fte-year__pack-btn:hover {
  border-color: rgba(36, 54, 122, 0.5);
}

.fte-year__pack-btn.is-selected {
  background: #24367a;
  border-color: #24367a;
  color: #ffffff;
}

.fte-year__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 14px;
}

.fte-year__slot {
  position: relative;
  background: #ffffff;
  border-radius: 16px;
  padding: 20px;
  min-height: 118px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  overflow: hidden;
  box-shadow: 0 1px 2px rgba(16, 33, 88, 0.05);
}

/* Mapped-product slots are clickable cards */
.fte-year__slot--linked {
  transition: box-shadow 140ms ease, transform 140ms ease;
}

.fte-year__slot--linked:hover {
  box-shadow: 0 6px 18px rgba(16, 33, 88, 0.12);
  transform: translateY(-2px);
}

.fte-year__slot--linked:focus-within {
  box-shadow: 0 0 0 2px #24367a;
}

.fte-year__media {
  margin: -20px -20px 2px;
  background: #e7e9f2;
  line-height: 0;
}

.fte-year__media-img {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 7;
  object-fit: cover;
  display: block;
}

.fte-year__slot-main {
  display: flex;
  align-items: center;
  gap: 12px;
}

.fte-year__thumb {
  width: 52px;
  height: 52px;
  flex: 0 0 auto;
  border-radius: 10px;
  object-fit: cover;
  background: #e7e9f2;
}

.fte-year__slot-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.fte-year__slot-link {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.35;
  color: #24367a;
  text-decoration: none;
}

/* Stretch the link over the whole card, under the lock overlay */
.fte-year__slot-link::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
}

.fte-year__slot--linked:hover .fte-year__slot-link {
  text-decoration: underline;
  text-underline-offset: 2px;
}

.fte-year__slot-cta {
  margin-top: auto;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #2B3886;
}

.fte-year__slot-cta span {
  display: inline-block;
  transition: transform 140ms ease;
}

.fte-year__slot--linked:hover .fte-year__slot-cta span {
  transform: translateX(3px);
}

.fte-year__slot-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.fte-year__slot-n {
  font-size: 12px;
  font-weight: 700;
  color: #98a0bf;
}

.fte-year__tag {
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 3px 9px;
  border-radius: 999px;
}

.fte-year__tag--compulsory {
  background: #F0C417;
  color: #1e2a5e;
}

.fte-year__tag--elective {
  border: 1.5px solid rgba(43, 56, 134, 0.35);
  color: #2B3886;
  padding: 2px 9px;
}

.fte-year__slot-label {
  font-size: 14px;
  font-weight: 600;
  color: #24367a;
}

.fte-year__slot-sub {
  font-size: 12.5px;
  color: #8a91b4;
  margin-top: -4px;
}

/* Inside a mapped-product card the gap already spaces the sub-label */
.fte-year__slot-text .fte-year__slot-sub {
  margin-top: 0;
}

.fte-year__token {
  display: inline-block;
  align-self: flex-start;
  padding: 4px 11px;
  border: 1.5px dashed #c9a511;
  background: #fbf3d2;
  border-radius: 8px;
  font-weight: 700;
  color: #8a7106;
  font-size: 13px;
}

/* Locked state (pack toggle) */
.fte-year__lock {
  position: absolute;
  inset: 0;
  z-index: 2; /* above the stretched product link, so locked slots are not clickable */
  border-radius: 16px;
  background: rgba(240, 241, 245, 0.86);
  -webkit-backdrop-filter: blur(1px);
  backdrop-filter: blur(1px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 14px;
  text-align: center;
}

.fte-year__slot.is-locked .fte-year__lock {
  display: flex;
}

.fte-year__lock-label {
  font-size: 12.5px;
  font-weight: 700;
  color: #6f789f;
  line-height: 1.4;
}

.fte-year__footnote {
  margin: 18px 0 0;
  font-size: 12px;
  line-height: 1.5;
  color: #8a91b4;
  max-width: 640px;
}

@media (max-width: 767px) {
  .fte-year__inner {
    padding: 0 16px;
  }
}
</style>

{%- if section.settings.show_pack_toggle -%}
<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-fte-year]');
    if (!root) return;
    var btns = root.querySelectorAll('.fte-year__pack-btn');
    var slots = root.querySelectorAll('.fte-year__slot');

    function apply(pack) {
      slots.forEach(function (slot) {
        var min = parseInt(slot.getAttribute('data-pack-min') || '6', 10);
        var label = slot.querySelector('.fte-year__lock-label');
        var link = slot.querySelector('.fte-year__slot-link');
        var locked = min > pack;

        if (locked) {
          slot.classList.add('is-locked');
          if (label) label.textContent = 'Add with the ' + min + ' credit pack';
        } else {
          slot.classList.remove('is-locked');
        }

        // Keep a locked slot's product link out of the tab order too
        if (link) {
          if (locked) {
            link.setAttribute('tabindex', '-1');
          } else {
            link.removeAttribute('tabindex');
          }
        }
      });
    }

    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        btns.forEach(function (b) { b.classList.remove('is-selected'); b.setAttribute('aria-pressed', 'false'); });
        btn.classList.add('is-selected');
        btn.setAttribute('aria-pressed', 'true');
        apply(parseInt(btn.getAttribute('data-pack'), 10));
      });
    });

    apply(parseInt(root.getAttribute('data-default-pack') || '8', 10));
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "FTE Your Year",
  "tag": "section",
  "class": "fte-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your Year at OEO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Grade 12 year, credit by credit"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Compulsory slots are set by Ministry requirements. Elective slots are yours. Your counsellor confirms your selections after enrolment, and you adjust them together as your plans change."
    },
    {
      "type": "header",
      "content": "Mapped course products"
    },
    {
      "type": "select",
      "id": "product_image_style",
      "label": "Product image",
      "info": "Applies to slots that have a product mapped.",
      "options": [
        { "value": "cover", "label": "Cover image across the top" },
        { "value": "thumb", "label": "Square thumbnail beside the title" },
        { "value": "none", "label": "No image" }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "product_cta_label",
      "label": "Card link label",
      "default": "View course"
    },
    {
      "type": "header",
      "content": "Credit pack toggle (Grade 12)"
    },
    {
      "type": "checkbox",
      "id": "show_pack_toggle",
      "label": "Show credit-pack toggle",
      "info": "Grade 12 only. Turn off for Grade 9 to 11, which have a fixed 8-credit load.",
      "default": false
    },
    {
      "type": "text",
      "id": "pack_toggle_label",
      "label": "Toggle label",
      "default": "Credit pack"
    },
    {
      "type": "select",
      "id": "default_pack",
      "label": "Default pack",
      "options": [
        { "value": "6", "label": "6 credits" },
        { "value": "7", "label": "7 credits" },
        { "value": "8", "label": "8 credits" }
      ],
      "default": "8"
    },
    {
      "type": "header",
      "content": "Footnote"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Compulsory and elective split shown for layout only. Compulsory-credit lists are drafted from the Ontario curriculum and verified by OEO before publish."
    }
  ],
  "blocks": [
    {
      "type": "slot",
      "name": "Credit slot",
      "settings": [
        {
          "type": "select",
          "id": "kind",
          "label": "Slot type",
          "options": [
            { "value": "compulsory", "label": "Compulsory" },
            { "value": "elective", "label": "Elective" }
          ],
          "default": "compulsory"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Course product",
          "info": "Map this credit to a real course. The card then shows the product image and links to its product page."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "info": "Leave the default when a product is mapped and the product title is used. Compulsory without a product: the course name, or the bracketed placeholder until OEO verifies the list. Elective without a product: e.g. 'Open slot'.",
          "default": "[ Course TBC · pending verification ]"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "Sub-label",
          "info": "Optional. With a product mapped, this replaces the course code shown under the title."
        },
        {
          "type": "select",
          "id": "pack_min",
          "label": "Unlocks at pack",
          "info": "Grade 12 only: the smallest credit pack that includes this slot.",
          "options": [
            { "value": "6", "label": "6 credit pack" },
            { "value": "7", "label": "7 credit pack" },
            { "value": "8", "label": "8 credit pack" }
          ],
          "default": "6"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "FTE Your Year",
      "settings": {
        "show_pack_toggle": true
      },
      "blocks": [
        { "type": "slot", "settings": { "kind": "compulsory", "pack_min": "6" } },
        { "type": "slot", "settings": { "kind": "compulsory", "pack_min": "6" } },
        { "type": "slot", "settings": { "kind": "elective", "title": "Open slot", "sublabel": "Chosen with your counsellor", "pack_min": "6" } },
        { "type": "slot", "settings": { "kind": "elective", "title": "Open slot", "sublabel": "Chosen with your counsellor", "pack_min": "6" } },
        { "type": "slot", "settings": { "kind": "elective", "title": "Open slot", "sublabel": "Chosen with your counsellor", "pack_min": "6" } },
        { "type": "slot", "settings": { "kind": "elective", "title": "Open slot", "sublabel": "Chosen with your counsellor", "pack_min": "6" } },
        { "type": "slot", "settings": { "kind": "elective", "title": "Open slot", "sublabel": "Chosen with your counsellor", "pack_min": "7" } },
        { "type": "slot", "settings": { "kind": "elective", "title": "Open slot", "sublabel": "Chosen with your counsellor", "pack_min": "8" } }
      ]
    }
  ]
}
{% endschema %}
