<section class="pdp-course-details" aria-labelledby="pdp-course-details-heading">
  <div class="pdp-course-details__inner">

    <p class="pdp-course-details__eyebrow">
      {{ section.settings.eyebrow | default: 'Course Information' }}
    </p>
    <h2 class="pdp-course-details__heading" id="pdp-course-details-heading">
      {{ section.settings.heading | default: 'Course details at a glance' }}
    </h2>

{%- assign mf = product.metafields.custom -%}
{%- assign outline_link = mf.course_outline_link -%}
{%- assign curriculum_link = mf.curriculum_link -%}

    <div class="pdp-course-details__table-wrap">
      <table class="pdp-course-details__table" aria-label="{{ product.title | escape }} course details">
        <tbody>
          {%- if mf.course_code != blank -%}
            <tr>
              <td>Course Code</td>
              <td>{{ mf.course_code.value }}</td>
            </tr>
          {%- endif -%}

          {%- if mf.credit_value != blank -%}
            <tr>
              <td>Credit Value</td>
              <td>{{ mf.credit_value.value }}</td>
            </tr>
          {%- endif -%}

          {%- if mf.grade_level != blank -%}
            <tr>
              <td>Grade Level</td>
              <td>{{ mf.grade_level.value }}</td>
            </tr>
          {%- endif -%}

          {%- if mf.subject != blank -%}
            <tr>
              <td>Subject</td>
              <td>{{ mf.subject.value }}</td>
            </tr>
          {%- endif -%}

          {%- if mf.prerequisite != blank or section.settings.prereq_help_text != blank -%}
            <tr>
              <td>Prerequisite</td>
              <td>
                {%- if mf.prerequisite != blank -%}
                  {{ mf.prerequisite.value }}
                {%- endif -%}

                {%- if section.settings.prereq_help_text != blank and section.settings.prereq_help_url != blank -%}
                  <a
                    href="{{ section.settings.prereq_help_url }}"
                    class="pdp-course-details__prereq-link"
                  >
                    {{ section.settings.prereq_help_text }}
                  </a>
                {%- endif -%}
              </td>
            </tr>
          {%- endif -%}

          {%- if section.settings.delivery_method != blank -%}
            <tr>
              <td>Delivery Method</td>
              <td>{{ section.settings.delivery_method }}</td>
            </tr>
          {%- endif -%}

          {%- if section.settings.assessment != blank -%}
            <tr>
              <td>Assessment</td>
              <td>{{ section.settings.assessment }}</td>
            </tr>
          {%- endif -%}

          {%- if section.settings.feedback_turnaround != blank -%}
            <tr>
              <td>Feedback Turnaround</td>
              <td>{{ section.settings.feedback_turnaround }}</td>
            </tr>
          {%- endif -%}

          {%- if section.settings.typical_completion != blank -%}
            <tr>
              <td>Typical Completion</td>
              <td>{{ section.settings.typical_completion }}</td>
            </tr>
          {%- endif -%}

          {%- if section.settings.start_date != blank -%}
            <tr>
              <td>Start Date</td>
              <td>{{ section.settings.start_date }}</td>
            </tr>
          {%- endif -%}

          {%- if section.settings.official_transcript != blank -%}
            <tr>
              <td>Official Transcript</td>
              <td>{{ section.settings.official_transcript }}</td>
            </tr>
          {%- endif -%}
          {%- for block in section.blocks -%}
  {%- if block.type == 'extra_row' and block.settings.label != blank and block.settings.value != blank -%}
    <tr {{ block.shopify_attributes }}>
      <td>{{ block.settings.label }}</td>
      <td>{{ block.settings.value }}</td>
    </tr>
  {%- endif -%}
{%- endfor -%}
          </tbody>
      </table>
    </div>

{%- comment -%} Document buttons are gated by the customizer checkbox "Show outline and curriculum buttons". Default is off. Tick it in the customizer to bring both back, no code change needed. {%- endcomment -%}
{%- if section.settings.show_document_buttons -%}
{%- if outline_link != blank or curriculum_link != blank -%}
  <div class="pdp-course-details__buttons">
    {%- if outline_link != blank -%}
      <a
        href="{{ outline_link.value }}"
        class="pdp-course-details__outline-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View the {{ product.title | escape }} course outline"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1v8M4.5 6.5L7 9l2.5-2.5M2 12h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        {{ section.settings.outline_button_label | default: 'View Course Outline' }}
      </a>
    {%- endif -%}

    {%- if curriculum_link != blank -%}
      <a
        href="{{ curriculum_link.value }}"
        class="pdp-course-details__outline-btn"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View the {{ product.title | escape }} course curriculum"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1v8M4.5 6.5L7 9l2.5-2.5M2 12h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        {{ section.settings.curriculum_button_label | default: 'View Course Curriculum' }}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}
{%- endif -%}

  </div>
</section>

<style>
.pdp-course-details {
  background: var(--light);
  padding: 0 0 72px;
}

.pdp-course-details__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}

.pdp-course-details__eyebrow {
  margin: 0 0 10px;
  font-size: 11px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #98a0bf;
}

.pdp-course-details__heading {
  margin: 0 0 32px;
  font-size: clamp(2rem, 3vw, 2.45rem);
  line-height: 1.08;
  letter-spacing: -0.03em;
  font-weight: 800;
  color: #24367a;
}

.pdp-course-details__table-wrap {
  overflow: hidden;
  border-radius: 14px;
  border: 1px solid rgba(36, 54, 122, 0.08);
  background: #fff;
}

.pdp-course-details__table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

.pdp-course-details__table tr:nth-child(odd) td {
  background: #ffffff;
}

.pdp-course-details__table tr:nth-child(even) td {
  background: #f7f7fa;
}

.pdp-course-details__table td {
  padding: 14px 18px;
  vertical-align: middle;
}

.pdp-course-details__table td:first-child {
  width: 220px;
  white-space: nowrap;
  font-size: 13px;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #98a0bf;
}

.pdp-course-details__table td:last-child {
  font-size: 15px;
  line-height: 1.55;
  font-weight: 500;
  color: #33457f;
}

.pdp-course-details__prereq-link {
  display: inline-block;
  margin-left: 10px;
  color: #8f96b6;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.pdp-course-details__prereq-link:hover {
  color: #24367a;
}

.pdp-course-details__outline-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-top: 20px;
  padding: 13px 18px;
  border: 1px solid rgba(36, 54, 122, 0.16);
  border-radius: 999px;
  color: #31457e;
  background: transparent;
  font-size: 15px;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;
  transition: all .2s ease;
}

.pdp-course-details__outline-btn:hover {
  background: #31457e;
  color: #fff;
  border-color: #31457e;
}

.pdp-course-details__buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 20px;
}

@media (max-width: 767px) {
  .pdp-course-details__inner {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 16px;
  }

  .pdp-course-details__heading {
    margin-bottom: 24px;
    font-size: 2rem;
    line-height: 1.1;
  }

    .pdp-course-details__buttons {
    flex-direction: column;
    align-items: flex-start;
  }

  .pdp-course-details__outline-btn {
    width: auto;
  }

  .pdp-course-details__table {
    table-layout: auto; /* let columns size naturally */
  }

  .pdp-course-details__table td {
    padding: 14px 12px;
  }

  .pdp-course-details__table td:first-child {
    width: 40%;
    max-width: 170px;
    white-space: normal;        /* allow wrap */
    word-break: break-word;     /* break long words if needed */
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.12em;
  }

  .pdp-course-details__table td:last-child {
    font-size: 15px;
    line-height: 1.55;
  }

  .pdp-course-details__prereq-link {
    display: block;
    margin-left: 0;
    margin-top: 6px;
  }

  .pdp-course-details__outline-btn {
    margin-top: 18px;
    font-size: 14px;
    padding: 12px 16px;
  }
}
</style>

{% schema %}
{
  "name": "PDP Course Details",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Course Information"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Course details at a glance"
    },
    {
      "type": "textarea",
      "id": "delivery_method",
      "label": "Delivery Method",
      "default": "100% Online, Self-Paced. No scheduled classes or login requirements"
    },
    {
      "type": "textarea",
      "id": "assessment",
      "label": "Assessment",
      "default": "Assignments, teacher evaluations, and a final exam written online."
    },
    {
      "type": "textarea",
      "id": "feedback_turnaround",
      "label": "Feedback Turnaround",
      "default": "Within 24 hours on weekdays"
    },
    {
      "type": "textarea",
      "id": "typical_completion",
      "label": "Typical Completion",
      "default": "4–8 weeks (work at your own pace, no minimum)"
    },
    {
      "type": "textarea",
      "id": "start_date",
      "label": "Start Date",
      "default": "Enrol any day. Course access begins within 24 hours of payment"
    },
    {
      "type": "textarea",
      "id": "official_transcript",
      "label": "Official Transcript",
      "default": "Issued directly to you or your university by OEO"
    },
    {
      "type": "text",
      "id": "prereq_help_text",
      "label": "Prerequisite Help Link Text",
      "default": "(Not sure if you qualify? Ask us →)"
    },
    {
      "type": "url",
      "id": "prereq_help_url",
      "label": "Prerequisite Help Link URL"
    },
    {
      "type": "checkbox",
      "id": "show_document_buttons",
      "label": "Show outline and curriculum buttons",
      "default": false,
      "info": "Controls both PDF buttons. Each button still requires its metafield to be populated."
    },
    {
      "type": "text",
      "id": "outline_button_label",
      "label": "Outline Button Label",
      "default": "Download Course Outline (PDF)"
    },
    {
      "type": "text",
      "id": "curriculum_button_label",
      "label": "Curriculum Button Label",
      "default": "View Course Curriculum"
    }
  ],
  "blocks": [
    {
      "type": "extra_row",
      "name": "Additional Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row Label",
          "default": "Additional Info"
        },
        {
          "type": "textarea",
          "id": "value",
          "label": "Row Value",
          "default": "Add the value for this row."
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "PDP Course Details"
    }
  ]
}
{% endschema %}
