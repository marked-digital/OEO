{% render 'intl-css' %}
<section class="oeo-lp lp-sec lp-two">
  <div class="lp-inner">
    <div class="lp-two__head">
      {% if section.settings.eyebrow != blank %}<div class="lp-eyebrow lp-eyebrow--center">{{ section.settings.eyebrow }}</div>{% endif %}
      <h2 class="lp-two__h">{{ section.settings.heading }}</h2>
    </div>
    <div class="lp-two__grid">
      <div class="lp-card lp-two__card lp-two__card--a">
        <span class="lp-two__icon lp-two__icon--a">{% render 'intl-icon', icon: 'cap', size: 26 %}</span>
        <h3>{{ section.settings.a_title }}</h3>
        <p>{{ section.settings.a_body }}</p>
      </div>
      <div class="lp-card lp-two__card lp-two__card--b">
        <span class="lp-two__icon lp-two__icon--b">{% render 'intl-icon', icon: 'award', size: 26 %}</span>
        <h3>{{ section.settings.b_title }}</h3>
        <p>{{ section.settings.b_body }}</p>
      </div>
    </div>
    {% if section.settings.cta_label != blank %}
      <div class="lp-two__cta">
        {% if section.settings.cta_sub != blank %}<p class="lp-two__cta-sub">{{ section.settings.cta_sub }}</p>{% endif %}
        <a class="button button--lg" href="{{ section.settings.cta_url | default: '#' }}" style="--button-background: 240 196 23 / var(--button-background-opacity, 1); --button-outline-color: 240 196 23; --button-text-color: 42 56 132;">{{ section.settings.cta_label }}</a>
      </div>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Intl • Two ways to study",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Two ways to study with us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete a full diploma, or take the credits you need." },
    { "type": "header", "content": "Card A — Full diploma" },
    { "type": "text", "id": "a_title", "label": "Card A title", "default": "Full OSSD diploma" },
    { "type": "textarea", "id": "a_body", "label": "Card A body", "default": "Complete your entire Ontario Secondary School Diploma online and graduate with a recognized Canadian credential." },
    { "type": "header", "content": "Card B — Individual credits" },
    { "type": "text", "id": "b_title", "label": "Card B title", "default": "Individual credits" },
    { "type": "textarea", "id": "b_body", "label": "Card B body", "default": "Already studying in your home country? Take individual Ontario credits to strengthen your university application or add subjects your school does not offer. We send your official report card and transcript directly to your school or chosen institution." },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_sub", "label": "CTA subcopy", "default": "Browse Grade 9 to 12 courses by subject or grade, and start any day of the year." },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Explore Courses" },
    { "type": "url", "id": "cta_url", "label": "CTA button link" }
  ],
  "presets": [{ "name": "Intl • Two ways to study" }]
}
{% endschema %}
