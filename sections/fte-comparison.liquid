{%- comment -%}
  Full-Time Enrolment · Comparison table (Wireframe B, new section)
  Full-time at OEO vs a traditional day school, reusing the homepage comparison
  motif. Each row is a block: a label, the OEO value (highlighted), and the
  traditional-school value. Placed after the OSSD Pathway Strip on the PDP.
{%- endcomment -%}

<section class="fte-cmp" aria-labelledby="fte-cmp-heading-{{ section.id }}">
  <div class="fte-cmp__inner">

    <div class="fte-cmp__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fte-cmp__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="fte-cmp__heading" id="fte-cmp-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="fte-cmp__table" role="table" aria-label="{{ section.settings.heading | escape }}">
      <div class="fte-cmp__row fte-cmp__row--header" role="row">
        <span role="columnheader"></span>
        <span class="fte-cmp__col-oeo" role="columnheader">{{ section.settings.col_oeo | default: 'Full-Time at OEO' | escape }}</span>
        <span class="fte-cmp__col-trad" role="columnheader">{{ section.settings.col_traditional | default: 'Traditional day school' | escape }}</span>
      </div>

      {%- comment -%}
        The two tag spans are hidden on desktop, where the header row already
        labels the columns. On mobile the row stacks and the header row is
        moved off-screen, so each value carries its own visible column tag.
        They are aria-hidden: the header row still supplies the real
        columnheader semantics at every breakpoint.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'row' -%}
          <div class="fte-cmp__row" role="row" {{ block.shopify_attributes }}>
            <span class="fte-cmp__label" role="rowheader">{{ block.settings.label | escape }}</span>
            <span class="fte-cmp__tag fte-cmp__tag--oeo" aria-hidden="true">{{ section.settings.col_oeo | default: 'Full-Time at OEO' | escape }}</span>
            <span class="fte-cmp__oeo" role="cell">
              <span class="fte-cmp__check" aria-hidden="true">
                <svg viewBox="0 0 12 12" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.2l2.2 2.2L9.5 3.6"/></svg>
              </span>
              {{ block.settings.oeo_value | escape }}
            </span>
            <span class="fte-cmp__tag fte-cmp__tag--trad" aria-hidden="true">{{ section.settings.col_traditional | default: 'Traditional day school' | escape }}</span>
            <span class="fte-cmp__trad" role="cell">{{ block.settings.traditional_value | escape }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
.fte-cmp {
  background: #ffffff;
  padding: clamp(48px, 7vw, 80px) 0;
}

.fte-cmp__inner {
  max-width: 960px;
  margin: 0 auto;
  padding: 0 32px;
}

.fte-cmp__head {
  max-width: 620px;
  margin-bottom: 28px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fte-cmp__eyebrow {
  margin: 0;
  font-size: 11px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #98a0bf;
}

.fte-cmp__heading {
  margin: 0;
  font-size: clamp(1.75rem, 2.8vw, 2.25rem);
  line-height: 1.12;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: #24367a;
}

.fte-cmp__table {
  border: 1px solid rgba(36, 54, 122, 0.12);
  border-radius: 20px;
  overflow: hidden;
}

.fte-cmp__row {
  display: grid;
  grid-template-columns: minmax(84px, 1fr) minmax(120px, 1.25fr) minmax(96px, 1fr);
  gap: 12px;
  padding: 15px 18px;
  align-items: center;
  border-bottom: 1px solid rgba(36, 54, 122, 0.08);
}

.fte-cmp__row:last-child {
  border-bottom: none;
}

.fte-cmp__row--header {
  background: var(--color-dark, #1e2460);
  padding: 14px 18px;
}

.fte-cmp__col-oeo {
  font-size: 13px;
  font-weight: 800;
  color: #F0C417;
}

.fte-cmp__col-trad {
  font-size: 13px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.65);
}

.fte-cmp__label {
  font-size: 13px;
  font-weight: 700;
  color: #24367a;
}

.fte-cmp__oeo {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13.5px;
  font-weight: 600;
  color: #24367a;
  background: var(--light, #f0f1f5);
  border-radius: 10px;
  padding: 9px 12px;
}

.fte-cmp__check {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #F0C417;
  color: #1e2a5e;
}

.fte-cmp__trad {
  font-size: 13px;
  color: #8a91b4;
}

/* Column tags are a mobile-only affordance; the header row covers desktop */
.fte-cmp__tag {
  display: none;
}

@media (max-width: 767px) {
  .fte-cmp__inner {
    padding: 0 16px;
  }

  /* Three columns cannot hold a sentence on a phone, so each row becomes a
     stacked block: dimension on top, then the two values full width. */
  .fte-cmp__row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 18px 16px;
  }

  /* Header row stays in the accessibility tree, off-screen, so the cells below
     keep their columnheader association. */
  .fte-cmp__row--header {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .fte-cmp__label {
    font-size: 14px;
    padding-bottom: 10px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(36, 54, 122, 0.08);
  }

  .fte-cmp__tag {
    display: block;
    margin-bottom: 6px;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fte-cmp__tag--oeo {
    color: #24367a;
  }

  .fte-cmp__tag--trad {
    margin-top: 14px;
    color: #a8afcb;
  }

  /* Both values share a block shape so their edges and text line up */
  .fte-cmp__oeo,
  .fte-cmp__trad {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 15px;
    line-height: 1.45;
  }

  .fte-cmp__trad {
    background: transparent;
    border: 1px solid rgba(36, 54, 122, 0.1);
    color: #6f789f;
  }

  /* Muted counterpart to the gold check, so both value lines start at the
     same x-position */
  .fte-cmp__trad::before {
    content: '';
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 1px;
    border-radius: 50%;
    background-color: rgba(36, 54, 122, 0.07);
    background-image: linear-gradient(#a8afcb, #a8afcb);
    background-size: 8px 1.5px;
    background-repeat: no-repeat;
    background-position: center;
  }

  .fte-cmp__check {
    margin-top: 1px;
  }
}
</style>

{% schema %}
{
  "name": "FTE Comparison",
  "tag": "section",
  "class": "fte-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How we compare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Full-time at OEO vs a traditional day school"
    },
    {
      "type": "text",
      "id": "col_oeo",
      "label": "OEO column heading",
      "default": "Full-Time at OEO"
    },
    {
      "type": "text",
      "id": "col_traditional",
      "label": "Traditional column heading",
      "default": "Traditional day school"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Start date"
        },
        {
          "type": "text",
          "id": "oeo_value",
          "label": "OEO value",
          "default": "Start any day of the year"
        },
        {
          "type": "text",
          "id": "traditional_value",
          "label": "Traditional value",
          "default": "September intake"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "FTE Comparison",
      "blocks": [
        { "type": "row", "settings": { "label": "Start date", "oeo_value": "Start any day of the year", "traditional_value": "September intake" } },
        { "type": "row", "settings": { "label": "Pacing", "oeo_value": "Self-paced, 2 to 4 courses at a time", "traditional_value": "Fixed timetable" } },
        { "type": "row", "settings": { "label": "Final exams", "oeo_value": "Written online, from anywhere", "traditional_value": "Scheduled exam weeks" } },
        { "type": "row", "settings": { "label": "Guidance", "oeo_value": "Named counsellor owns your pathway", "traditional_value": "Shared caseload" } },
        { "type": "row", "settings": { "label": "Where you learn", "oeo_value": "Anywhere, on any device", "traditional_value": "Commute to class" } }
      ]
    }
  ]
}
{% endschema %}
