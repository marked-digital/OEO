{% render 'intl-css' %}
<section class="oeo-lp lp-sec lp-uni" id="university-pathway">
  <div class="lp-inner">
    <div class="lp-uni__top">
      <div>
        {% if section.settings.eyebrow != blank %}<div class="lp-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
        <h2 class="lp-uni__h">{{ section.settings.heading }}</h2>
        {% if section.settings.body != blank %}<div class="lp-uni__p">{{ section.settings.body }}</div>{% endif %}
      </div>
      <div class="lp-uni__checks">
        {% for block in section.blocks %}{% if block.type == 'check' %}
          <div class="lp-card lp-card--flat lp-uni__check" {{ block.shopify_attributes }}>
            <span class="lp-uni__check-ico">{% render 'intl-icon', icon: 'check', size: 13 %}</span>
            <span class="t">{{ block.settings.text }}</span>
          </div>
        {% endif %}{% endfor %}
      </div>
    </div>
    <div class="lp-uni__wall">
      {% for block in section.blocks %}{% if block.type == 'logo' %}
        <div class="lp-uni__tile" title="{{ block.settings.name | escape }}" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.name | escape }}">
          {% else %}
            <span>{{ block.settings.name }}</span>
          {% endif %}
        </div>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Intl • University pathway",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where our students go" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our graduates go on to Canada's top universities." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Ontario Education Online is a fully accredited Ontario private school. Our OSSD credits are recognized by universities across Canada and internationally.</p>" }
  ],
  "blocks": [
    { "type": "check", "name": "Checklist item", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "OSSD Credits Issued" } ] },
    { "type": "logo", "name": "University logo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Logo image (leave empty to show the name as text)" },
      { "type": "text", "id": "name", "label": "University name", "default": "University of Toronto" }
    ] }
  ],
  "presets": [{
    "name": "Intl • University pathway",
    "blocks": [
      { "type": "check", "settings": { "text": "Ministry-Inspected BSID 882902" } },
      { "type": "check", "settings": { "text": "OSSD Credits Issued" } },
      { "type": "check", "settings": { "text": "OCT-Certified Teachers" } },
      { "type": "check", "settings": { "text": "Recognized by Leading Universities" } },
      { "type": "logo", "settings": { "name": "University of Toronto" } },
      { "type": "logo", "settings": { "name": "McGill University" } },
      { "type": "logo", "settings": { "name": "University of British Columbia" } },
      { "type": "logo", "settings": { "name": "McMaster University" } },
      { "type": "logo", "settings": { "name": "University of Waterloo" } },
      { "type": "logo", "settings": { "name": "University of Ottawa" } },
      { "type": "logo", "settings": { "name": "Western University" } },
      { "type": "logo", "settings": { "name": "Queen's University" } },
      { "type": "logo", "settings": { "name": "Dalhousie University" } },
      { "type": "logo", "settings": { "name": "University of Guelph" } },
      { "type": "logo", "settings": { "name": "York University" } },
      { "type": "logo", "settings": { "name": "Carleton University" } },
      { "type": "logo", "settings": { "name": "Toronto Metropolitan University" } },
      { "type": "logo", "settings": { "name": "Wilfrid Laurier University" } },
      { "type": "logo", "settings": { "name": "University of Alberta" } }
    ]
  }]
}
{% endschema %}
