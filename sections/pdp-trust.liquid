<section class="pdp-values" aria-label="School credentials and university recognition">
  <div class="pdp-values__inner">
    <div class="pdp-values__grid">

      {%- for block in section.blocks -%}
        <div class="pdp-values__item" {{ block.shopify_attributes }}>
          <div class="pdp-values__icon-wrap" aria-hidden="true">
            {%- case block.settings.icon -%}

              {%- when 'school' -%}
                <svg class="pdp-values__icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1.5 21H20.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M4 21V10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M18 21V10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M1.5 10.5L11 3L20.5 10.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M8 21V15.5H14V21" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

              {%- when 'teacher' -%}
                <svg class="pdp-values__icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="11" cy="8" r="4" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M3 21C3 16.6 6.6 13 11 13C15.4 13 19 16.6 19 21" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  <path d="M14.5 4L17.5 6L14.5 8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

              {%- when 'cap' -%}
                <svg class="pdp-values__icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11 14L1.5 9L11 4L20.5 9L11 14Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M5.5 11.5V17C5.5 19 8 20.5 11 20.5C14 20.5 16.5 19 16.5 17V11.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M20.5 9V14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>

              {%- else -%}
                <svg class="pdp-values__icon" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.4"/>
                </svg>
            {%- endcase -%}
          </div>

          <div class="pdp-values__content">
            {%- if block.settings.title != blank -%}
              <div class="pdp-values__title">{{ block.settings.title }}</div>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="pdp-values__desc">{{ block.settings.description }}</div>
            {%- endif -%}

            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <a
                class="pdp-values__link"
                href="{{ block.settings.link_url }}"
                {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                {{ block.settings.link_label }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}

    </div>
  </div>
</section>

<style>
.pdp-values {
  background: #f5f5f7;
  padding: 34px 0 38px;
  border-top: 1px solid rgba(36, 54, 122, 0.08);
}

.pdp-values__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}

.pdp-values__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  align-items: start;
}

.pdp-values__item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  min-width: 0;
}


.pdp-values__icon-wrap {
  width: 52px;
  height: 52px;
  min-width: 52px;
  border-radius: 999px;
  background: #ffffff;
  color: #2a3884;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 1px 2px rgba(17, 33, 89, 0.04),
    0 4px 14px rgba(17, 33, 89, 0.06);
}

.pdp-values__icon {
  width: 24px;
  height: 24px;
  display: block;
}

.pdp-values__content {
  flex: 1 1 auto;
  min-width: 0;
}

.pdp-values__title {
  margin: 0 0 6px;
  font-size: 16px;
  line-height: 1.25;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: #2a3884;
  white-space: nowrap;
}

.pdp-values__desc {
  margin: 0;
  font-size: 14px;
  line-height: 1.45;
  color: #8088ac;
}

.pdp-values__link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 8px;
  font-size: 16px;
  line-height: 1.35;
  font-weight: 500;
  color: #6571a5;
  text-decoration: none;
}

.pdp-values__link:hover {
  color: #2a3884;
}

.pdp-values__link::after {
  content: "↗";
  font-size: 0.9em;
  line-height: 1;
}

/* Tablet */
@media (max-width: 989px) {
  .pdp-values__grid {
    gap: 28px;
  }

  .pdp-values__title {
    font-size: 17px;
  }

  .pdp-values__desc,
  .pdp-values__link {
    font-size: 15px;
  }
}

/* Mobile */
@media (max-width: 767px) {
  .pdp-values {
    padding: 28px 0 30px;
  }

  .pdp-values__inner {
    padding: 0 20px;
  }

  .pdp-values__grid {
    grid-template-columns: 1fr;
    gap: 26px;
  }

  .pdp-values__item {
    gap: 16px;
  }

  .pdp-values__icon-wrap {
    width: 56px;
    height: 56px;
    min-width: 56px;
  }

  .pdp-values__icon {
    width: 22px;
    height: 22px;
  }

  .pdp-values__title {
    margin-bottom: 6px;
    font-size: 17px;
    line-height: 1.25;
  }

  .pdp-values__desc {
    font-size: 15px;
    line-height: 1.5;
  }

  .pdp-values__link {
    margin-top: 6px;
    font-size: 15px;
  }
}
</style>

{% schema %}
{
  "name": "PDP - Trust",
  "settings": [],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "school",
          "options": [
            { "value": "school", "label": "School" },
            { "value": "teacher", "label": "Teacher" },
            { "value": "cap", "label": "Graduation cap" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Ministry-Inspected School"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "BSID #882902"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Verify on Ministry site"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP - Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "school",
            "title": "Ministry-Inspected School",
            "description": "BSID #882902",
            "link_label": "Verify on Ministry site"
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "teacher",
            "title": "Ontario-Certified Teacher",
            "description": "All courses taught by OCT-regulated educators",
            "link_label": ""
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "cap",
            "title": "Credits Accepted Everywhere in Ontario",
            "description": "U of T, McMaster, Western, Queen's, York, Ottawa, and all others",
            "link_label": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}