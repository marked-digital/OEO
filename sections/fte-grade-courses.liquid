{%- comment -%}
  Full-Time Enrolment · All courses offered for a grade
  Sits under "Your Year at OEO" and feeds off a grade-level collection, so the
  full course catalogue for that grade stays in one place (the collection) and
  this section never needs per-course blocks.

  The grade number in the heading is derived from the collection title when it
  contains "Grade N" ("Grade 12 Courses" → 12); the Grade setting overrides it
  when a collection is named differently.

  Layout: a scroll-snap carousel. Desktop shows the configured cards-per-view
  (4 by default) with prev/next controls; tablet and mobile shrink to a peeked
  track that swipes, with a scroll-progress bar instead of arrows. Every card
  opens its course product in a new tab so the enrolment page is not lost.
{%- endcomment -%}

{%- assign courses_collection = section.settings.collection -%}
{%- assign per_view = section.settings.per_view | default: 4 | plus: 0 -%}

{%- comment -%} Grade token: explicit setting first, then the collection title. {%- endcomment -%}
{%- assign grade = section.settings.grade | strip -%}
{%- if grade == blank and courses_collection.title contains 'Grade ' -%}
  {%- assign grade = courses_collection.title | split: 'Grade ' | last | split: ' ' | first | strip -%}
{%- endif -%}

{%- assign heading = section.settings.heading | replace: '{grade}', grade | strip -%}

{%- assign course_list = courses_collection.products -%}

{%- if course_list.size == 0 and request.design_mode == false -%}
  {%- comment -%} Nothing mapped yet: render nothing on the live page. {%- endcomment -%}
{%- else -%}

<section
  class="fte-courses"
  aria-labelledby="fte-courses-heading-{{ section.id }}"
  data-fte-courses
  style="--fte-courses-desktop-per-view: {{ per_view }};"
>
  <div class="fte-courses__inner">

    <div class="fte-courses__head">
      <div class="fte-courses__head-text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="fte-courses__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="fte-courses__heading" id="fte-courses-heading-{{ section.id }}">{{ heading | escape }}</h2>
        {%- if section.settings.body != blank -%}
          <p class="fte-courses__body">{{ section.settings.body | escape }}</p>
        {%- endif -%}
      </div>

      <div class="fte-courses__head-aside">
        {%- if course_list.size > 0 -%}
          <span class="fte-courses__count">{{ course_list.size }} {% if course_list.size == 1 %}course{% else %}courses{% endif %}</span>
        {%- endif -%}
        <div class="fte-courses__nav" data-courses-nav>
          <button
            type="button"
            class="fte-courses__arrow"
            data-courses-prev
            aria-label="Previous courses"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button
            type="button"
            class="fte-courses__arrow"
            data-courses-next
            aria-label="More courses"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>

    {%- if course_list.size > 0 -%}
      <div
        class="fte-courses__track"
        data-courses-track
        tabindex="0"
        role="group"
        aria-label="{{ heading | escape }}"
      >
        {%- for course in course_list limit: section.settings.max_products -%}
          {%- assign course_code = course.metafields.custom.course_code.value -%}
          {%- if course_code == blank -%}
            {%- assign course_code = course.title | split: ' ' | first -%}
          {%- endif -%}
          {%- assign course_variant = course.selected_or_first_available_variant -%}

          <article class="fte-courses__card">
            <div class="fte-courses__cover">
              {%- if course.featured_image -%}
                <img
                  class="fte-courses__cover-img"
                  src="{{ course.featured_image | image_url: width: 600 }}"
                  alt="{{ course.featured_image.alt | default: course.title | escape }}"
                  width="600"
                  height="150"
                  loading="lazy"
                  decoding="async"
                >
              {%- endif -%}
              <span class="fte-courses__cover-code">{{ course_code | escape }}</span>
            </div>

            <div class="fte-courses__card-body">
              <h3 class="fte-courses__name">
                <a
                  class="fte-courses__name-link"
                  href="{{ course.url }}"
                  target="_blank"
                  rel="noopener"
                  aria-label="{{ course.title | escape }} (opens in a new tab)"
                >{{ course.title | escape }}</a>
              </h3>

              {%- if section.settings.show_description and course.description != blank -%}
                <p class="fte-courses__desc">{{ course.description | strip_html | truncate: 110 }}</p>
              {%- endif -%}

              <div class="fte-courses__card-footer">
                {%- if section.settings.show_price and course_variant -%}
                  <span class="fte-courses__price">{{ course_variant.price | money }}</span>
                {%- endif -%}
                <span class="fte-courses__cta" aria-hidden="true">
                  {{ section.settings.card_cta_label | default: 'View course' | escape }} <span>↗</span>
                </span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>

      <div class="fte-courses__progress" data-courses-progress aria-hidden="true">
        <span class="fte-courses__progress-bar" data-courses-progress-bar></span>
      </div>

      {%- if section.settings.show_view_all and courses_collection != blank -%}
        <a class="fte-courses__all" href="{{ courses_collection.url }}" target="_blank" rel="noopener">
          {{ section.settings.view_all_label | default: 'Browse the full course list' | escape }} <span aria-hidden="true">↗</span>
        </a>
      {%- endif -%}

    {%- else -%}
      <div class="fte-courses__placeholder">
        Pick a grade-level collection in this section's settings to list its courses here.
      </div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="fte-courses__footnote">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}

  </div>
</section>

<style>
.fte-courses {
  background: #ffffff;
  padding: clamp(48px, 7vw, 80px) 0;
}

.fte-courses__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
}

.fte-courses__head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.fte-courses__head-text {
  max-width: 620px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.fte-courses__eyebrow {
  margin: 0;
  font-size: 11px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #98a0bf;
}

.fte-courses__heading {
  margin: 0;
  font-size: clamp(2rem, 3vw, 2.45rem);
  line-height: 1.1;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: #24367a;
}

.fte-courses__body {
  margin: 0;
  font-size: 16px;
  line-height: 1.7;
  color: #6f789f;
  text-wrap: pretty;
}

.fte-courses__head-aside {
  display: flex;
  align-items: center;
  gap: 16px;
}

.fte-courses__count {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #98a0bf;
  white-space: nowrap;
}

.fte-courses__nav {
  display: flex;
  gap: 8px;
}

.fte-courses__arrow {
  width: 42px;
  height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  border: 1.5px solid rgba(36, 54, 122, 0.25);
  background: #ffffff;
  color: #24367a;
  cursor: pointer;
  transition: border-color 120ms ease, background 120ms ease, opacity 120ms ease;
}

.fte-courses__arrow:hover {
  border-color: #24367a;
  background: #f0f1f5;
}

.fte-courses__arrow[disabled] {
  opacity: 0.32;
  cursor: default;
}

.fte-courses__track {
  /* Cards read both vars; the breakpoints below retune them per device. The
     desktop count comes from the section setting as an inline var. */
  --fte-courses-per-view: var(--fte-courses-desktop-per-view, 4);
  --fte-courses-gap: 20px;
  display: flex;
  gap: var(--fte-courses-gap);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
  /* room for the cards' hover lift */
  padding: 4px 0 8px;
  margin: -4px 0 0;
}

.fte-courses__track::-webkit-scrollbar {
  display: none;
}

.fte-courses__track:focus-visible {
  outline: 2px solid #24367a;
  outline-offset: 4px;
  border-radius: 14px;
}

.fte-courses__card {
  position: relative;
  flex: 0 0 calc((100% - (var(--fte-courses-per-view) - 1) * var(--fte-courses-gap)) / var(--fte-courses-per-view));
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  overflow: hidden;
  transition: box-shadow 180ms ease, transform 180ms ease, border-color 180ms ease;
}

.fte-courses__card:hover,
.fte-courses__card:focus-within {
  border-color: rgba(36, 54, 122, 0.3);
  box-shadow: 0 8px 24px rgba(16, 33, 88, 0.12);
  transform: translateY(-2px);
}

.fte-courses__cover {
  position: relative;
  height: 132px;
  display: flex;
  align-items: flex-start;
  padding: 12px 14px;
  background: #24367a;
  overflow: hidden;
}

.fte-courses__cover-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 0;
}

.fte-courses__cover-code {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 999px;
  background: #1e2a5e;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #ffffff;
  white-space: nowrap;
}

.fte-courses__card-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: 8px;
  padding: 18px;
}

.fte-courses__name {
  margin: 0;
  font-size: 0.97rem;
  font-weight: 700;
  line-height: 1.35;
  color: #24367a;
}

.fte-courses__name-link {
  color: inherit;
  text-decoration: none;
}

/* Stretch the course link across the card */
.fte-courses__name-link::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 2;
}

.fte-courses__card:hover .fte-courses__name-link {
  text-decoration: underline;
  text-underline-offset: 2px;
}

.fte-courses__desc {
  margin: 0;
  font-size: 0.85rem;
  line-height: 1.55;
  color: #6b7280;
  flex: 1;
}

.fte-courses__card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: auto;
  padding-top: 6px;
}

.fte-courses__price {
  font-size: 0.95rem;
  font-weight: 700;
  color: #24367a;
  white-space: nowrap;
}

.fte-courses__cta {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #2B3886;
  margin-left: auto;
}

.fte-courses__cta span {
  display: inline-block;
  transition: transform 140ms ease;
}

.fte-courses__card:hover .fte-courses__cta span {
  transform: translate(2px, -2px);
}

.fte-courses__progress {
  display: none;
  height: 3px;
  border-radius: 999px;
  background: #e7e9f2;
  margin-top: 14px;
  overflow: hidden;
}

.fte-courses__progress-bar {
  display: block;
  height: 100%;
  width: 30%;
  border-radius: 999px;
  background: #24367a;
  transform: translateX(0);
  transition: transform 90ms linear;
}

.fte-courses__all {
  display: inline-block;
  margin-top: 22px;
  font-size: 14px;
  font-weight: 700;
  color: #2B3886;
  text-decoration: none;
  border-bottom: 1.5px solid rgba(43, 56, 134, 0.35);
  padding-bottom: 2px;
}

.fte-courses__all:hover {
  border-bottom-color: #2B3886;
}

.fte-courses__placeholder {
  padding: 32px;
  border: 2px dashed #d1d5db;
  border-radius: 14px;
  text-align: center;
  color: #9ca3af;
  font-size: 0.9rem;
}

.fte-courses__footnote {
  margin: 18px 0 0;
  font-size: 12px;
  line-height: 1.5;
  color: #8a91b4;
  max-width: 640px;
}

@media (max-width: 1100px) {
  .fte-courses__track {
    --fte-courses-per-view: 3;
  }
}

@media (max-width: 860px) {
  .fte-courses__track {
    --fte-courses-per-view: 2;
  }
}

@media (max-width: 767px) {
  .fte-courses__inner {
    padding: 0 16px;
  }

  .fte-courses__head {
    margin-bottom: 20px;
  }

  /* Touch swipe replaces the arrows; the progress bar shows there is more */
  .fte-courses__nav {
    display: none;
  }

  .fte-courses__progress {
    display: block;
  }

  .fte-courses__track {
    --fte-courses-gap: 14px;
    /* peek the next card so the swipe reads as available */
    --fte-courses-per-view: 1.25;
    scroll-snap-type: x proximity;
  }

  .fte-courses__cover {
    height: 120px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .fte-courses__track {
    scroll-behavior: auto;
  }

  .fte-courses__card {
    transition: none;
  }
}
</style>

<script>
  (function () {
    var root = document.querySelector('#shopify-section-{{ section.id }} [data-fte-courses]');
    if (!root) return;

    var track = root.querySelector('[data-courses-track]');
    if (!track) return;

    var prev = root.querySelector('[data-courses-prev]');
    var next = root.querySelector('[data-courses-next]');
    var bar = root.querySelector('[data-courses-progress-bar]');

    function maxScroll() {
      return track.scrollWidth - track.clientWidth;
    }

    function pageSize() {
      var card = track.querySelector('.fte-courses__card');
      if (!card) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap || '20') || 20;
      var step = card.getBoundingClientRect().width + gap;
      // Advance by whole cards, at most one viewport at a time
      var perPage = Math.max(1, Math.floor(track.clientWidth / step));
      return step * perPage;
    }

    function update() {
      var max = maxScroll();
      var x = track.scrollLeft;

      if (prev) prev.disabled = x <= 2;
      if (next) next.disabled = x >= max - 2;

      var nav = root.querySelector('[data-courses-nav]');
      if (nav) nav.style.visibility = max <= 2 ? 'hidden' : 'visible';

      if (bar) {
        var visible = max > 0 ? track.clientWidth / track.scrollWidth : 1;
        var width = Math.max(0.15, Math.min(1, visible)) * 100;
        bar.style.width = width + '%';
        var ratio = max > 0 ? x / max : 0;
        // Travel is the leftover space in the rail, expressed in bar widths
        var travel = width >= 100 ? 0 : ratio * (100 - width) / width * 100;
        bar.style.transform = 'translateX(' + travel + '%)';
      }
    }

    function scrollByPage(dir) {
      track.scrollBy({ left: dir * pageSize(), behavior: 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { scrollByPage(-1); });
    if (next) next.addEventListener('click', function () { scrollByPage(1); });

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);

    track.addEventListener('keydown', function (event) {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        scrollByPage(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        scrollByPage(-1);
      }
    });

    update();
  })();
</script>

{%- endif -%}

{% schema %}
{
  "name": "FTE Grade Courses",
  "tag": "section",
  "class": "fte-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Grade course collection",
      "info": "The grade-level collection whose courses are listed here, e.g. 'Grade 12 Courses'."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Course catalogue"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Use {grade} for the grade number. It is read from the collection title, or from the Grade override below.",
      "default": "All Courses Offered for Grade {grade}"
    },
    {
      "type": "text",
      "id": "grade",
      "label": "Grade override",
      "info": "Only needed when the collection is not titled 'Grade N ...'."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Every course available at this grade level. Your counsellor confirms which of them fill your credits at your guidance session."
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "per_view",
      "label": "Cards per view (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum courses shown",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 50
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show course description",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show course price",
      "default": false
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card link label",
      "default": "View course"
    },
    {
      "type": "header",
      "content": "Collection link"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show link to the full collection",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Collection link label",
      "default": "Browse the full course list"
    },
    {
      "type": "header",
      "content": "Footnote"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "info": "Optional.",
      "default": "Course availability is confirmed at your guidance session. Courses open in a new tab."
    }
  ],
  "presets": [
    {
      "name": "FTE Grade Courses"
    }
  ]
}
{% endschema %}
